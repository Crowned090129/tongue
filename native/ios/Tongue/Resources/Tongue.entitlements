<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs (Push Notifications capability).
	     Use "development" for debug builds and "production" for App Store / TestFlight.
	     Xcode's automatic signing manages the matching entitlement when you add the
	     "Push Notifications" capability under Signing & Capabilities. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
