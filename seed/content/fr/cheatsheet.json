{"categories":[
{"name":"Salutations et Politesse","items":[
{"target":"Bonjour","ref":"Hello / Good morning","note":"Default daytime greeting; always polite to add it before a request"},
{"target":"Bonsoir","ref":"Good evening","note":"Used from late afternoon onward"},
{"target":"Salut","ref":"Hi / Bye","note":"Informal, for friends only"},
{"target":"Au revoir","ref":"Goodbye","note":"Literally 'until seeing again'"},
{"target":"À bientôt","ref":"See you soon","note":"Also à demain (tomorrow), à tout à l'heure (later today)"},
{"target":"Merci beaucoup","ref":"Thank you very much","note":"Reply with de rien or je vous en prie"},
{"target":"S'il vous plaît","ref":"Please","note":"Formal; use s'il te plaît with someone you address as tu"},
{"target":"Pardon","ref":"Excuse me / Sorry","note":"To get attention or apologize for a small bump"},
{"target":"Excusez-moi","ref":"Excuse me","note":"More formal; excuse-moi in the tu form"},
{"target":"Comment allez-vous ?","ref":"How are you?","note":"Formal; informal is Ça va ?"},
{"target":"Enchanté(e)","ref":"Nice to meet you","note":"Add -e in writing if the speaker is female"},
{"target":"Bienvenue","ref":"Welcome","note":"Said when receiving a guest"}
]},
{"name":"Les Nombres","items":[
{"target":"un, deux, trois","ref":"1, 2, 3","note":"un becomes une before a feminine noun"},
{"target":"quatre, cinq, six","ref":"4, 5, 6","note":"the final consonant of cinq/six/dix is pronounced when counting"},
{"target":"sept, huit, neuf, dix","ref":"7, 8, 9, 10","note":"neuf ends in an 'f' sound except in neuf heures/ans (v)"},
{"target":"onze, douze, treize","ref":"11, 12, 13","note":"11–16 are single words ending in -ze"},
{"target":"quatorze, quinze, seize","ref":"14, 15, 16","note":"from 17 on, they become compounds: dix-sept, dix-huit, dix-neuf"},
{"target":"vingt","ref":"20","note":"the t is silent alone but pronounced in vingt-deux… vingt-neuf"},
{"target":"trente, quarante, cinquante","ref":"30, 40, 50","note":"regular tens"},
{"target":"soixante","ref":"60","note":"the last 'regular' ten"},
{"target":"soixante-dix","ref":"70","note":"literally 'sixty-ten'; 71 = soixante et onze, 79 = soixante-dix-neuf"},
{"target":"quatre-vingts","ref":"80","note":"literally 'four twenties'; drops the -s in 81–89 (quatre-vingt-un)"},
{"target":"quatre-vingt-dix","ref":"90","note":"'four-twenty-ten'; 91 = quatre-vingt-onze"},
{"target":"cent, mille","ref":"100, 1000","note":"cent takes -s when multiplied and final (deux cents) but mille never changes"}
]},
{"name":"Jours, Mois et Saisons","items":[
{"target":"lundi, mardi, mercredi","ref":"Monday, Tuesday, Wednesday","note":"days are masculine and not capitalized"},
{"target":"jeudi, vendredi","ref":"Thursday, Friday","note":"le vendredi = 'on Fridays' (habitual)"},
{"target":"samedi, dimanche","ref":"Saturday, Sunday","note":"the French week starts on Monday"},
{"target":"janvier, février, mars","ref":"January, February, March","note":"use en or au mois de: en mars"},
{"target":"avril, mai, juin","ref":"April, May, June","note":"months are masculine, lowercase"},
{"target":"juillet, août","ref":"July, August","note":"août can be pronounced 'oot' or 'a-oo'"},
{"target":"septembre, octobre","ref":"September, October","note":"—"},
{"target":"novembre, décembre","ref":"November, December","note":"—"},
{"target":"le printemps","ref":"spring","note":"the only season taking au: au printemps"},
{"target":"l'été","ref":"summer","note":"en été; été is masculine"},
{"target":"l'automne","ref":"autumn / fall","note":"en automne"},
{"target":"l'hiver","ref":"winter","note":"en hiver; note the silent h"}
]},
{"name":"Verbes Essentiels (je/tu/il)","items":[
{"target":"être : je suis, tu es, il est","ref":"to be","note":"the most irregular French verb"},
{"target":"avoir : j'ai, tu as, il a","ref":"to have","note":"also used for age: j'ai vingt ans"},
{"target":"aller : je vais, tu vas, il va","ref":"to go","note":"builds the near future: je vais partir"},
{"target":"faire : je fais, tu fais, il fait","ref":"to do / to make","note":"used for weather: il fait beau"},
{"target":"pouvoir : je peux, tu peux, il peut","ref":"to be able to / can","note":"question form: puis-je ?"},
{"target":"vouloir : je veux, tu veux, il veut","ref":"to want","note":"polite form is je voudrais"},
{"target":"devoir : je dois, tu dois, il doit","ref":"to have to / must","note":"also means 'to owe'"},
{"target":"savoir : je sais, tu sais, il sait","ref":"to know (a fact/how)","note":"vs connaître = to be acquainted with"},
{"target":"venir : je viens, tu viens, il vient","ref":"to come","note":"venir de + infinitive = to have just done"},
{"target":"dire : je dis, tu dis, il dit","ref":"to say / to tell","note":"vous dites (not disez) is irregular"}
]},
{"name":"Mots Interrogatifs et Connecteurs","items":[
{"target":"qui","ref":"who","note":"qui est-ce ? = who is it?"},
{"target":"que / quoi","ref":"what","note":"que before a verb, quoi after a preposition (à quoi ?)"},
{"target":"où","ref":"where","note":"note the accent to distinguish from ou (or)"},
{"target":"quand","ref":"when","note":"the d links: quand il (kã-t-il)"},
{"target":"comment","ref":"how","note":"also 'what' in Comment ? (pardon?)"},
{"target":"pourquoi","ref":"why","note":"answered with parce que"},
{"target":"combien","ref":"how much / how many","note":"combien de + noun"},
{"target":"quel / quelle","ref":"which / what","note":"agrees: quel homme, quelle femme"},
{"target":"et","ref":"and","note":"never elides: et il (no t sound)"},
{"target":"mais","ref":"but","note":"—"},
{"target":"donc","ref":"so / therefore","note":"—"},
{"target":"parce que","ref":"because","note":"answers pourquoi; parce qu' before a vowel"}
]},
{"name":"Phrases de Survie","items":[
{"target":"Je ne comprends pas.","ref":"I don't understand.","note":"add Pardon ? to ask for a repeat"},
{"target":"Pouvez-vous répéter ?","ref":"Can you repeat?","note":"add lentement (slowly) if needed"},
{"target":"Parlez-vous anglais ?","ref":"Do you speak English?","note":"—"},
{"target":"Comment dit-on … en français ?","ref":"How do you say … in French?","note":"key phrase for learning on the go"},
{"target":"Où sont les toilettes ?","ref":"Where is the toilet?","note":"toilettes is always plural"},
{"target":"Je voudrais …","ref":"I would like …","note":"the polite way to order or request"},
{"target":"Combien ça coûte ?","ref":"How much is it?","note":"or Ça fait combien ?"},
{"target":"Au secours !","ref":"Help!","note":"emergency; also À l'aide !"},
{"target":"Je suis perdu(e).","ref":"I'm lost.","note":"add -e in speech/writing if female"},
{"target":"Appelez un médecin !","ref":"Call a doctor!","note":"emergency number in France is 112 or 15 (SAMU)"},
{"target":"Je ne sais pas.","ref":"I don't know.","note":"—"},
{"target":"L'addition, s'il vous plaît.","ref":"The bill, please.","note":"standard at the end of a meal"}
]},
{"name":"L'Heure et le Temps","items":[
{"target":"Quelle heure est-il ?","ref":"What time is it?","note":"il est … heures for the answer"},
{"target":"Il est une heure.","ref":"It's one o'clock.","note":"une (feminine) because heure is feminine"},
{"target":"Il est deux heures et quart.","ref":"It's a quarter past two.","note":"et quart = +15 min"},
{"target":"Il est trois heures et demie.","ref":"It's half past three.","note":"demie agrees with heure"},
{"target":"Il est quatre heures moins le quart.","ref":"It's a quarter to four.","note":"moins le quart = −15 min"},
{"target":"midi / minuit","ref":"noon / midnight","note":"no 'heures': il est midi"},
{"target":"du matin / de l'après-midi / du soir","ref":"a.m. / in the afternoon / p.m.","note":"clarifies the 12-hour clock"},
{"target":"quatorze heures","ref":"2 p.m. (14:00)","note":"official 24-hour clock, used for schedules"},
{"target":"aujourd'hui","ref":"today","note":"note the apostrophe and silent d"},
{"target":"demain / hier","ref":"tomorrow / yesterday","note":"après-demain = day after tomorrow"},
{"target":"maintenant","ref":"now","note":"—"},
{"target":"tôt / tard","ref":"early / late","note":"en retard = late (behind schedule)"}
]},
{"name":"Adjectifs Courants et Contraires","items":[
{"target":"grand / petit","ref":"big / small","note":"fem: grande / petite"},
{"target":"bon / mauvais","ref":"good / bad","note":"fem: bonne / mauvaise; go before the noun"},
{"target":"beau / laid","ref":"beautiful / ugly","note":"fem: belle / laide; beau→bel before a vowel"},
{"target":"jeune / vieux","ref":"young / old","note":"fem: jeune / vieille; vieux→vieil before a vowel"},
{"target":"nouveau / ancien","ref":"new / old (former)","note":"fem: nouvelle / ancienne"},
{"target":"chaud / froid","ref":"hot / cold","note":"fem: chaude / froide"},
{"target":"facile / difficile","ref":"easy / difficult","note":"end in -e: no change in feminine"},
{"target":"heureux / triste","ref":"happy / sad","note":"fem: heureuse / triste"},
{"target":"rapide / lent","ref":"fast / slow","note":"fem: rapide / lente"},
{"target":"cher / bon marché","ref":"expensive / cheap","note":"fem: chère; bon marché is invariable"},
{"target":"propre / sale","ref":"clean / dirty","note":"propre before a noun means 'own'"},
{"target":"fort / faible","ref":"strong / weak","note":"fem: forte / faible"}
]},
{"name":"Au Restaurant et la Nourriture","items":[
{"target":"Une table pour deux, s'il vous plaît.","ref":"A table for two, please.","note":"—"},
{"target":"la carte / le menu","ref":"the menu / the fixed-price set menu","note":"beware: le menu is often a set meal, la carte is the à-la-carte list"},
{"target":"Je voudrais commander.","ref":"I would like to order.","note":"—"},
{"target":"l'entrée","ref":"the starter","note":"false friend: entrée = appetizer, not main course"},
{"target":"le plat principal","ref":"the main course","note":"le plat du jour = today's special"},
{"target":"le dessert","ref":"dessert","note":"—"},
{"target":"une carafe d'eau","ref":"a jug of tap water","note":"free in French restaurants; ask for it by name"},
{"target":"un verre de vin rouge","ref":"a glass of red wine","note":"blanc = white, rosé = rosé"},
{"target":"Qu'est-ce que vous recommandez ?","ref":"What do you recommend?","note":"—"},
{"target":"C'était délicieux.","ref":"It was delicious.","note":"a compliment to the chef/waiter"},
{"target":"le pourboire","ref":"the tip","note":"service is included (service compris); a small extra is optional"},
{"target":"Bon appétit !","ref":"Enjoy your meal!","note":"said before eating"}
]},
{"name":"Articles et Partitifs","items":[
{"target":"le","ref":"the (masculine)","note":"le livre; becomes l' before a vowel"},
{"target":"la","ref":"the (feminine)","note":"la table; becomes l' before a vowel"},
{"target":"les","ref":"the (plural)","note":"les livres; the s links before a vowel (les_amis)"},
{"target":"un","ref":"a / an (masculine)","note":"un homme"},
{"target":"une","ref":"a / an (feminine)","note":"une femme"},
{"target":"des","ref":"some / (plural a)","note":"des livres; becomes de before an adjective + noun"},
{"target":"du","ref":"some (masculine)","note":"partitive; = de + le; du pain"},
{"target":"de la","ref":"some (feminine)","note":"partitive; de la soupe"},
{"target":"de l'","ref":"some (before a vowel)","note":"de l'eau, de l'argent"},
{"target":"pas de","ref":"not any / no","note":"all indefinite/partitive articles become de after a negative"},
{"target":"au","ref":"to/at the (masculine)","note":"= à + le; je vais au marché"},
{"target":"aux","ref":"to/at the (plural)","note":"= à + les; aux États-Unis"}
]},
{"name":"Prépositions et Lieu","items":[
{"target":"à","ref":"to / at / in","note":"à Paris, à l'école; contracts to au/aux"},
{"target":"de","ref":"of / from","note":"je viens de Lyon; contracts to du/des"},
{"target":"en","ref":"in / to","note":"used with feminine countries: en France, en Italie"},
{"target":"chez","ref":"at someone's place","note":"chez moi, chez le médecin"},
{"target":"sur / sous","ref":"on / under","note":"sur la table, sous la chaise"},
{"target":"dans","ref":"in / inside","note":"dans la boîte"},
{"target":"devant / derrière","ref":"in front of / behind","note":"—"},
{"target":"à côté de","ref":"next to","note":"uses de: à côté de la banque"},
{"target":"en face de","ref":"across from / opposite","note":"—"},
{"target":"entre","ref":"between","note":"entre la poste et la gare"},
{"target":"près de / loin de","ref":"near / far from","note":"—"},
{"target":"à gauche / à droite","ref":"on the left / on the right","note":"tout droit = straight ahead (false friend of droite)"}
]},
{"name":"Faux Amis et Expressions","items":[
{"target":"actuellement","ref":"currently (not 'actually')","note":"'actually' = en fait / en réalité"},
{"target":"assister à","ref":"to attend (not 'to assist')","note":"'to assist' = aider"},
{"target":"la librairie","ref":"bookshop (not 'library')","note":"'library' = la bibliothèque"},
{"target":"sensible","ref":"sensitive (not 'sensible')","note":"'sensible' = raisonnable"},
{"target":"Ça marche.","ref":"That works / OK.","note":"literally 'that walks'; very common"},
{"target":"avoir faim / soif","ref":"to be hungry / thirsty","note":"literally 'to have hunger/thirst', uses avoir not être"},
{"target":"avoir raison / tort","ref":"to be right / wrong","note":"also uses avoir"},
{"target":"il y a","ref":"there is / there are","note":"invariable; also 'ago': il y a deux jours"},
{"target":"avoir envie de","ref":"to feel like / want","note":"j'ai envie d'un café"},
{"target":"quand même","ref":"anyway / still","note":"very common filler of agreement or concession"},
{"target":"n'importe quoi","ref":"nonsense / anything at all","note":"casual; also n'importe où (anywhere), n'importe qui (anyone)"},
{"target":"Ça y est.","ref":"That's it / It's done.","note":"marks completion"}
]}
]}
