{"categories":[
{"name":"Greetings & Farewells","items":[
{"target":"Hallo","ref":"Hello","note":"HAH-loh — neutral, works anywhere"},
{"target":"Guten Morgen","ref":"Good morning","note":"until about 11 a.m."},
{"target":"Guten Tag","ref":"Good day / Hello","note":"the standard polite daytime greeting"},
{"target":"Guten Abend","ref":"Good evening","note":"GOO-ten AH-bent"},
{"target":"Grüß Gott","ref":"Hello (God greet you)","note":"southern Germany & Austria"},
{"target":"Wie geht es Ihnen?","ref":"How are you? (formal)","note":"informal: Wie geht's?"},
{"target":"Auf Wiedersehen","ref":"Goodbye","note":"formal; on the phone: Auf Wiederhören"},
{"target":"Tschüss","ref":"Bye","note":"chewss — casual"},
{"target":"Bis bald","ref":"See you soon","note":"literally 'until soon'"},
{"target":"Bis morgen","ref":"See you tomorrow","note":"bis + time = 'until…'"},
{"target":"Gute Nacht","ref":"Good night","note":"only when going to bed"},
{"target":"Schönen Tag noch!","ref":"Have a nice day!","note":"friendly parting line"}
]},
{"name":"Numbers 1–20","items":[
{"target":"eins","ref":"one","note":"as an article: ein/eine"},
{"target":"zwei","ref":"two","note":"on the phone often 'zwo' to avoid confusion with drei"},
{"target":"drei","ref":"three","note":"dry"},
{"target":"vier","ref":"four","note":"feer — not like 'fire'"},
{"target":"fünf","ref":"five","note":"fünf with ü rounded lips"},
{"target":"sechs","ref":"six","note":"zeks"},
{"target":"sieben","ref":"seven","note":"ZEE-ben"},
{"target":"acht","ref":"eight","note":"ch as in Scottish 'loch'"},
{"target":"neun","ref":"nine","note":"noyn"},
{"target":"zehn","ref":"ten","note":"tsayn"},
{"target":"elf","ref":"eleven","note":"same as the word for elf"},
{"target":"zwölf","ref":"twelve","note":"tsvölf"},
{"target":"dreizehn","ref":"thirteen","note":"13–19 = digit + zehn"},
{"target":"vierzehn","ref":"fourteen","note":"FEER-tsayn"},
{"target":"fünfzehn","ref":"fifteen","note":"FÜNF-tsayn"},
{"target":"sechzehn","ref":"sixteen","note":"note: sech-zehn, not sechs-zehn"},
{"target":"siebzehn","ref":"seventeen","note":"note: sieb-zehn, not sieben-zehn"},
{"target":"achtzehn","ref":"eighteen","note":"AHKT-tsayn"},
{"target":"neunzehn","ref":"nineteen","note":"NOYN-tsayn"},
{"target":"zwanzig","ref":"twenty","note":"TSVAN-tsikh; 21 = einundzwanzig (one-and-twenty)"}
]},
{"name":"Days & Months","items":[
{"target":"Montag","ref":"Monday","note":"all days are masculine: am Montag = on Monday"},
{"target":"Dienstag","ref":"Tuesday","note":"DEENS-tahk"},
{"target":"Mittwoch","ref":"Wednesday","note":"literally 'mid-week'"},
{"target":"Donnerstag","ref":"Thursday","note":"Donner = thunder (Thor's day)"},
{"target":"Freitag","ref":"Friday","note":"FRY-tahk"},
{"target":"Samstag","ref":"Saturday","note":"also Sonnabend in the north"},
{"target":"Sonntag","ref":"Sunday","note":"Sonne = sun"},
{"target":"Januar","ref":"January","note":"months are masculine: im Januar"},
{"target":"März","ref":"March","note":"mairts"},
{"target":"Mai","ref":"May","note":"my"},
{"target":"Juli","ref":"July","note":"often 'Julei' by phone to distinguish from Juni"},
{"target":"Oktober","ref":"October","note":"ok-TOH-ber"},
{"target":"Dezember","ref":"December","note":"day-TSEM-ber"},
{"target":"heute","ref":"today","note":"HOY-teh; gestern = yesterday, morgen = tomorrow"},
{"target":"die Woche","ref":"the week","note":"das Wochenende = the weekend"},
{"target":"der Monat","ref":"the month","note":"das Jahr = the year"},
{"target":"am Wochenende","ref":"at the weekend","note":"am = an dem (on the)"},
{"target":"nächste Woche","ref":"next week","note":"letzte Woche = last week"},
{"target":"jeden Tag","ref":"every day","note":"accusative for time spans"}
]},
{"name":"Essential Verbs (ich / du / er forms)","items":[
{"target":"sein — ich bin, du bist, er ist","ref":"to be — I am, you are, he is","note":"the most irregular verb"},
{"target":"haben — ich habe, du hast, er hat","ref":"to have — I have, you have, he has","note":"drops the b in du/er"},
{"target":"machen — ich mache, du machst, er macht","ref":"to do/make — I do, you do, he does","note":"fully regular model verb"},
{"target":"gehen — ich gehe, du gehst, er geht","ref":"to go — I go, you go, he goes","note":"Perfekt uses sein: ich bin gegangen"},
{"target":"können — ich kann, du kannst, er kann","ref":"can — I can, you can, he can","note":"modal; ich & er share one form"},
{"target":"wollen — ich will, du willst, er will","ref":"to want — I want, you want, he wants","note":"ich will = I want (false friend!)"},
{"target":"müssen — ich muss, du musst, er muss","ref":"must — I must, you must, he must","note":"ich muss nicht = I don't have to"},
{"target":"wissen — ich weiß, du weißt, er weiß","ref":"to know (facts) — I know…","note":"weiß with ß; use kennen for people/places"},
{"target":"kommen — ich komme, du kommst, er kommt","ref":"to come — I come, you come, he comes","note":"Perfekt uses sein: ich bin gekommen"},
{"target":"sagen — ich sage, du sagst, er sagt","ref":"to say — I say, you say, he says","note":"regular; wie sagt man…? = how do you say…?"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"wer?","ref":"who?","note":"vair — nominative; whom = wen/wem"},
{"target":"was?","ref":"what?","note":"vahss"},
{"target":"wo?","ref":"where?","note":"woher? = from where, wohin? = to where"},
{"target":"wann?","ref":"when?","note":"vahn"},
{"target":"warum?","ref":"why?","note":"answer with weil (because)"},
{"target":"wie?","ref":"how?","note":"wie viel? = how much, wie viele? = how many"},
{"target":"welcher?","ref":"which?","note":"changes ending by gender: welche, welches"},
{"target":"und","ref":"and","note":"does not change word order"},
{"target":"aber","ref":"but","note":"keeps normal word order"},
{"target":"oder","ref":"or","note":"OH-der"},
{"target":"weil","ref":"because","note":"sends the verb to the end of the clause"},
{"target":"deshalb","ref":"therefore / that's why","note":"triggers inversion: deshalb bleibe ich"}
]},
{"name":"Survival Phrases","items":[
{"target":"Entschuldigung!","ref":"Excuse me! / Sorry!","note":"to get attention or apologise"},
{"target":"Sprechen Sie Englisch?","ref":"Do you speak English?","note":"formal Sie form"},
{"target":"Ich verstehe nicht.","ref":"I don't understand.","note":"add das nicht for 'that'"},
{"target":"Können Sie das wiederholen?","ref":"Can you repeat that?","note":"or: langsamer, bitte = slower, please"},
{"target":"Wie viel kostet das?","ref":"How much does that cost?","note":"kostet = costs"},
{"target":"Wo ist die Toilette?","ref":"Where is the toilet?","note":"or: das WC (vay-tsay)"},
{"target":"Ich hätte gern…","ref":"I would like…","note":"the polite way to order or ask for"},
{"target":"Können Sie mir helfen?","ref":"Can you help me?","note":"mir = to me (dative)"},
{"target":"Ich suche den Bahnhof.","ref":"I'm looking for the station.","note":"der Bahnhof = train station"},
{"target":"Einen Fahrschein, bitte.","ref":"One ticket, please.","note":"Fahrschein / Ticket for transport"},
{"target":"Wann fährt der nächste Zug?","ref":"When does the next train leave?","note":"fahren = to depart (of vehicles)"},
{"target":"Hilfe!","ref":"Help!","note":"Rufen Sie die Polizei! = Call the police!"},
{"target":"Ich bin verloren.","ref":"I am lost.","note":"literally 'I am lost'"},
{"target":"Wo kann ich ein Taxi finden?","ref":"Where can I find a taxi?","note":"das Taxi is neuter"},
{"target":"Bitte","ref":"Please / You're welcome","note":"also the reply to Danke"}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"Wie spät ist es?","ref":"What time is it?","note":"literally 'how late is it?'"},
{"target":"Es ist ein Uhr.","ref":"It's one o'clock.","note":"ein Uhr, not eins Uhr"},
{"target":"Es ist drei Uhr.","ref":"It's three o'clock.","note":"…Uhr for full hours"},
{"target":"Viertel nach acht","ref":"quarter past eight","note":"8:15"},
{"target":"halb neun","ref":"half past eight (8:30)","note":"WATCH OUT: halb neun = half TO nine, i.e. 8:30"},
{"target":"Viertel vor zehn","ref":"quarter to ten","note":"9:45"},
{"target":"zwanzig nach sechs","ref":"twenty past six","note":"6:20"},
{"target":"um wie viel Uhr?","ref":"at what time?","note":"um + time = at…"},
{"target":"um zwölf Uhr","ref":"at twelve o'clock","note":"Mittag = noon, Mitternacht = midnight"},
{"target":"die Stunde","ref":"the hour","note":"die Minute = minute, die Sekunde = second"},
{"target":"morgens / abends","ref":"in the morning / evening","note":"add to clarify a.m./p.m."},
{"target":"14:30 Uhr","ref":"2:30 p.m.","note":"official times use the 24-hour clock: vierzehn Uhr dreißig"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"groß ↔ klein","ref":"big ↔ small","note":"grohss / klyne"},
{"target":"gut ↔ schlecht","ref":"good ↔ bad","note":"gut→besser→am besten"},
{"target":"neu ↔ alt","ref":"new ↔ old","note":"noy / ahlt"},
{"target":"heiß ↔ kalt","ref":"hot ↔ cold","note":"warm = warm, kühl = cool"},
{"target":"schnell ↔ langsam","ref":"fast ↔ slow","note":"SHNELL / LANG-zahm"},
{"target":"teuer ↔ billig","ref":"expensive ↔ cheap","note":"günstig = good value"},
{"target":"schön ↔ hässlich","ref":"beautiful ↔ ugly","note":"schön also = 'nice'"},
{"target":"leicht ↔ schwer","ref":"easy/light ↔ hard/heavy","note":"schwer means both difficult and heavy"},
{"target":"jung ↔ alt","ref":"young ↔ old","note":"yoong / ahlt"},
{"target":"voll ↔ leer","ref":"full ↔ empty","note":"foll / layr"},
{"target":"richtig ↔ falsch","ref":"correct ↔ wrong","note":"RIKH-tikh / falsh"},
{"target":"früh ↔ spät","ref":"early ↔ late","note":"frü / shpayt"},
{"target":"laut ↔ leise","ref":"loud ↔ quiet","note":"lowt / LY-zeh"},
{"target":"nah ↔ fern","ref":"near ↔ far","note":"more common: in der Nähe / weit weg"},
{"target":"offen ↔ geschlossen","ref":"open ↔ closed","note":"on shop signs: geöffnet / geschlossen"},
{"target":"glücklich ↔ traurig","ref":"happy ↔ sad","note":"GLÜK-likh / TROW-rikh"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"Einen Tisch für zwei, bitte.","ref":"A table for two, please.","note":"für + accusative"},
{"target":"Die Speisekarte, bitte.","ref":"The menu, please.","note":"die Karte for short"},
{"target":"Ich hätte gern das Schnitzel.","ref":"I would like the schnitzel.","note":"polite order form"},
{"target":"Was empfehlen Sie?","ref":"What do you recommend?","note":"empfehlen = to recommend"},
{"target":"Ich bin Vegetarier.","ref":"I am vegetarian.","note":"female: Vegetarierin"},
{"target":"Ein Bier vom Fass, bitte.","ref":"A draught beer, please.","note":"vom Fass = from the tap"},
{"target":"Noch ein Glas Wasser, bitte.","ref":"Another glass of water, please.","note":"still = ohne Kohlensäure, sparkling = mit"},
{"target":"Guten Appetit!","ref":"Enjoy your meal!","note":"said before eating"},
{"target":"Es hat sehr gut geschmeckt.","ref":"It tasted very good.","note":"schmecken = to taste (good)"},
{"target":"Die Rechnung, bitte.","ref":"The bill, please.","note":"or: Zahlen, bitte"},
{"target":"Zusammen oder getrennt?","ref":"Together or separately?","note":"the waiter's standard question"},
{"target":"Stimmt so.","ref":"Keep the change.","note":"tip is usually rounded up ~5-10%"},
{"target":"Zum Wohl! / Prost!","ref":"Cheers!","note":"make eye contact when clinking glasses"},
{"target":"Ich möchte bezahlen.","ref":"I would like to pay.","note":"bezahlen = to pay"},
{"target":"Zum Mitnehmen, bitte.","ref":"To take away, please.","note":"zum Mitnehmen = to go"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"Wie ist das Wetter?","ref":"What's the weather like?","note":"das Wetter = the weather"},
{"target":"Es ist sonnig.","ref":"It's sunny.","note":"die Sonne scheint = the sun shines"},
{"target":"Es regnet.","ref":"It's raining.","note":"der Regen = the rain"},
{"target":"Es schneit.","ref":"It's snowing.","note":"der Schnee = the snow"},
{"target":"Es ist windig.","ref":"It's windy.","note":"der Wind = the wind"},
{"target":"Es ist bewölkt.","ref":"It's cloudy.","note":"die Wolke = cloud"},
{"target":"Es ist heiß heute.","ref":"It's hot today.","note":"opposite: es ist kalt"},
{"target":"Schönes Wetter, nicht wahr?","ref":"Nice weather, isn't it?","note":"nicht wahr? = right? (tag question)"},
{"target":"Wie war dein Wochenende?","ref":"How was your weekend?","note":"classic Monday small talk"},
{"target":"Woher kommen Sie?","ref":"Where are you from?","note":"answer: Ich komme aus…"},
{"target":"Was machen Sie beruflich?","ref":"What do you do for work?","note":"beruflich = professionally"},
{"target":"Wie gefällt Ihnen Deutschland?","ref":"How do you like Germany?","note":"gefallen takes the dative"},
{"target":"Es geht so.","ref":"So-so / not bad.","note":"honest answer to 'how are you?'"},
{"target":"Alles klar!","ref":"All good! / Got it!","note":"very common filler"}
]},
{"name":"Family Members","items":[
{"target":"die Familie","ref":"the family","note":"fah-MEE-lee-eh"},
{"target":"die Eltern","ref":"the parents","note":"plural only"},
{"target":"der Vater","ref":"the father","note":"informal: Papa/Vati"},
{"target":"die Mutter","ref":"the mother","note":"informal: Mama/Mutti"},
{"target":"der Sohn","ref":"the son","note":"zohn"},
{"target":"die Tochter","ref":"the daughter","note":"TOKH-ter"},
{"target":"der Bruder","ref":"the brother","note":"plural: die Brüder"},
{"target":"die Schwester","ref":"the sister","note":"siblings = die Geschwister"},
{"target":"die Großeltern","ref":"the grandparents","note":"Opa & Oma informally"},
{"target":"der Großvater","ref":"the grandfather","note":"Opa"},
{"target":"die Großmutter","ref":"the grandmother","note":"Oma"},
{"target":"der Mann / die Frau","ref":"the husband / wife","note":"also mean man / woman"},
{"target":"das Kind","ref":"the child","note":"plural: die Kinder"},
{"target":"der/die Verwandte","ref":"the relative","note":"Verwandte = relatives (pl.)"}
]},
{"name":"Polite Requests & Etiquette","items":[
{"target":"Bitte.","ref":"Please. / You're welcome.","note":"the all-purpose polite word"},
{"target":"Danke schön.","ref":"Thank you very much.","note":"stronger: Vielen Dank"},
{"target":"Gern geschehen.","ref":"You're welcome / My pleasure.","note":"reply to Danke"},
{"target":"Entschuldigen Sie bitte…","ref":"Excuse me please…","note":"formal way to open a request"},
{"target":"Könnten Sie mir bitte helfen?","ref":"Could you please help me?","note":"Könnten = extra-polite (Konjunktiv II)"},
{"target":"Würden Sie…?","ref":"Would you…?","note":"softer than the plain command"},
{"target":"Darf ich…?","ref":"May I…?","note":"asking permission: Darf ich fragen?"},
{"target":"Es tut mir leid.","ref":"I'm sorry.","note":"for genuine apology; literally 'it does me sorrow'"},
{"target":"Kein Problem.","ref":"No problem.","note":"reassuring reply"},
{"target":"Nach Ihnen.","ref":"After you.","note":"holding a door"},
{"target":"Herzlichen Glückwunsch!","ref":"Congratulations!","note":"also for birthdays"},
{"target":"Siezen vs. Duzen","ref":"formal Sie vs. informal du","note":"use Sie with strangers/elders until invited to du"}
]}
]}
