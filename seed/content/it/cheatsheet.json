{"categories":[
{"name":"Greetings & Farewells","items":[
{"target":"Ciao","ref":"Hi / Bye","note":"informal, for both hello and goodbye"},
{"target":"Buongiorno","ref":"Good morning / Good day","note":"used until mid-afternoon"},
{"target":"Buonasera","ref":"Good evening","note":"from late afternoon onward"},
{"target":"Buonanotte","ref":"Good night","note":"only when going to bed"},
{"target":"Salve","ref":"Hello","note":"neutral, semi-formal, safe with anyone"},
{"target":"Arrivederci","ref":"Goodbye","note":"standard polite farewell"},
{"target":"A presto","ref":"See you soon","note":"lit. 'to soon'"},
{"target":"A domani","ref":"See you tomorrow","note":"a + time = 'see you...'"},
{"target":"A più tardi","ref":"See you later","note":"più tardi = later"},
{"target":"Come stai?","ref":"How are you?","note":"informal; formal is Come sta?"},
{"target":"Come va?","ref":"How's it going?","note":"casual; answer: bene, non c'è male"},
{"target":"Piacere","ref":"Nice to meet you","note":"said when introduced"}
]},
{"name":"Numbers 1-20","items":[
{"target":"uno","ref":"one","note":"OO-no; un/una before nouns"},
{"target":"due","ref":"two","note":"DOO-eh"},
{"target":"tre","ref":"three","note":"treh"},
{"target":"quattro","ref":"four","note":"KWAHT-tro"},
{"target":"cinque","ref":"five","note":"CHEEN-kweh"},
{"target":"sei","ref":"six","note":"say"},
{"target":"sette","ref":"seven","note":"SET-teh"},
{"target":"otto","ref":"eight","note":"OT-to"},
{"target":"nove","ref":"nine","note":"NO-veh"},
{"target":"dieci","ref":"ten","note":"DYEH-chee"},
{"target":"quindici","ref":"fifteen","note":"KWEEN-dee-chee"},
{"target":"venti","ref":"twenty","note":"VEN-tee"}
]},
{"name":"Days & Months","items":[
{"target":"lunedì","ref":"Monday","note":"loo-neh-DEE; days are not capitalized"},
{"target":"martedì","ref":"Tuesday","note":"mar-teh-DEE"},
{"target":"mercoledì","ref":"Wednesday","note":"mer-ko-leh-DEE"},
{"target":"giovedì","ref":"Thursday","note":"jo-veh-DEE"},
{"target":"venerdì","ref":"Friday","note":"veh-ner-DEE"},
{"target":"sabato","ref":"Saturday","note":"SAH-ba-to"},
{"target":"domenica","ref":"Sunday","note":"do-MEH-nee-ka; feminine"},
{"target":"gennaio","ref":"January","note":"jen-NAH-yo"},
{"target":"marzo","ref":"March","note":"MAR-tso"},
{"target":"giugno","ref":"June","note":"JOON-yo"},
{"target":"settembre","ref":"September","note":"set-TEM-breh"},
{"target":"dicembre","ref":"December","note":"dee-CHEM-breh"}
]},
{"name":"Essential Verbs (io/tu/lui)","items":[
{"target":"essere","ref":"to be","note":"io sono, tu sei, lui è"},
{"target":"avere","ref":"to have","note":"io ho, tu hai, lui ha (h is silent)"},
{"target":"fare","ref":"to do / make","note":"io faccio, tu fai, lui fa"},
{"target":"andare","ref":"to go","note":"io vado, tu vai, lui va"},
{"target":"potere","ref":"to be able / can","note":"io posso, tu puoi, lui può"},
{"target":"volere","ref":"to want","note":"io voglio, tu vuoi, lui vuole"},
{"target":"sapere","ref":"to know","note":"io so, tu sai, lui sa"},
{"target":"venire","ref":"to come","note":"io vengo, tu vieni, lui viene"},
{"target":"dire","ref":"to say / tell","note":"io dico, tu dici, lui dice"},
{"target":"stare","ref":"to stay / be","note":"io sto, tu stai, lui sta"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"Chi?","ref":"Who?","note":"kee"},
{"target":"Cosa? / Che cosa?","ref":"What?","note":"KO-za"},
{"target":"Quando?","ref":"When?","note":"KWAN-do"},
{"target":"Dove?","ref":"Where?","note":"DO-veh; dov'è? = where is?"},
{"target":"Perché?","ref":"Why?","note":"per-KEH; also means 'because'"},
{"target":"Come?","ref":"How?","note":"KO-meh"},
{"target":"Quanto?","ref":"How much?","note":"KWAN-to"},
{"target":"Quale?","ref":"Which?","note":"KWA-leh"},
{"target":"e","ref":"and","note":"becomes 'ed' before a vowel"},
{"target":"ma","ref":"but","note":"mah"},
{"target":"o","ref":"or","note":"oh"},
{"target":"quindi","ref":"so / therefore","note":"KWEEN-dee"}
]},
{"name":"Survival Phrases","items":[
{"target":"Un caffè, per favore.","ref":"A coffee, please.","note":"per favore = please"},
{"target":"Quanto costa?","ref":"How much does it cost?","note":"costano for plural"},
{"target":"Il conto, per favore.","ref":"The bill, please.","note":"in a restaurant"},
{"target":"Vorrei questo.","ref":"I would like this.","note":"vorrei is polite"},
{"target":"Dov'è il bagno?","ref":"Where is the bathroom?","note":"il bagno = restroom"},
{"target":"Dov'è la stazione?","ref":"Where is the station?","note":"la stazione = train station"},
{"target":"Un biglietto per Roma.","ref":"A ticket to Rome.","note":"il biglietto = ticket"},
{"target":"Posso pagare con la carta?","ref":"Can I pay by card?","note":"la carta = (credit) card"},
{"target":"Non capisco.","ref":"I don't understand.","note":"capire = to understand"},
{"target":"Può ripetere, per favore?","ref":"Can you repeat, please?","note":"formal request"},
{"target":"Parla inglese?","ref":"Do you speak English? (formal)","note":"informal: parli inglese?"},
{"target":"Mi aiuti, per favore.","ref":"Help me, please.","note":"aiutare = to help"}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"Che ore sono?","ref":"What time is it?","note":"also: Che ora è?"},
{"target":"È l'una.","ref":"It's one o'clock.","note":"singular for 1, noon, midnight"},
{"target":"Sono le due.","ref":"It's two o'clock.","note":"plural for 2 and above"},
{"target":"Sono le tre e mezza.","ref":"It's half past three.","note":"e mezza = and a half"},
{"target":"Sono le quattro e un quarto.","ref":"It's a quarter past four.","note":"e un quarto = and a quarter"},
{"target":"Sono le cinque meno un quarto.","ref":"It's a quarter to five.","note":"meno = minus/to"},
{"target":"mezzogiorno","ref":"noon","note":"lit. 'mid-day'"},
{"target":"mezzanotte","ref":"midnight","note":"lit. 'mid-night'"},
{"target":"di mattina","ref":"in the morning","note":"le otto di mattina = 8 a.m."},
{"target":"di pomeriggio","ref":"in the afternoon","note":"le tre di pomeriggio = 3 p.m."},
{"target":"di sera","ref":"in the evening","note":"le nove di sera = 9 p.m."},
{"target":"in punto","ref":"o'clock (sharp)","note":"le due in punto = 2 sharp"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"grande / piccolo","ref":"big / small","note":"endings agree: -o/-a/-i/-e"},
{"target":"buono / cattivo","ref":"good / bad","note":"buono shortens to buon before nouns"},
{"target":"bello / brutto","ref":"beautiful / ugly","note":"bello behaves like the article (bel, bei)"},
{"target":"nuovo / vecchio","ref":"new / old","note":"NWO-vo / VEK-kyo"},
{"target":"caldo / freddo","ref":"hot / cold","note":"fa caldo = it's hot (weather)"},
{"target":"alto / basso","ref":"tall / short","note":"also high / low"},
{"target":"facile / difficile","ref":"easy / difficult","note":"invariable in gender (-e ending)"},
{"target":"veloce / lento","ref":"fast / slow","note":"veloce is invariable in gender"},
{"target":"ricco / povero","ref":"rich / poor","note":"REEK-ko / PO-veh-ro"},
{"target":"felice / triste","ref":"happy / sad","note":"both invariable in gender"},
{"target":"pieno / vuoto","ref":"full / empty","note":"PYEH-no / VWO-to"},
{"target":"giovane / anziano","ref":"young / elderly","note":"anziano is polite for old (people)"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"Un tavolo per due, per favore.","ref":"A table for two, please.","note":"il tavolo = table"},
{"target":"Il menù, per favore.","ref":"The menu, please.","note":"menù with a final accent"},
{"target":"Cosa mi consiglia?","ref":"What do you recommend? (formal)","note":"consigliare = to advise"},
{"target":"Vorrei ordinare.","ref":"I'd like to order.","note":"ordinare = to order"},
{"target":"Per me la pasta.","ref":"Pasta for me.","note":"per me = for me"},
{"target":"Sono vegetariano.","ref":"I'm vegetarian.","note":"vegetariana if female"},
{"target":"Dell'acqua, per favore.","ref":"Some water, please.","note":"naturale (still) or frizzante (sparkling)"},
{"target":"È tutto buonissimo!","ref":"It's all delicious!","note":"buonissimo = very good"},
{"target":"Il conto, per favore.","ref":"The bill, please.","note":"you must usually ask for it"},
{"target":"Posso avere lo scontrino?","ref":"Can I have the receipt?","note":"lo scontrino = receipt"},
{"target":"Senza glutine, per favore.","ref":"Gluten-free, please.","note":"senza = without"},
{"target":"Buon appetito!","ref":"Enjoy your meal!","note":"said before eating"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"Che tempo fa?","ref":"What's the weather like?","note":"il tempo = weather and time"},
{"target":"Fa caldo.","ref":"It's hot.","note":"weather uses fare"},
{"target":"Fa freddo.","ref":"It's cold.","note":"fa fresco = it's cool"},
{"target":"C'è il sole.","ref":"It's sunny.","note":"lit. 'there is sun'"},
{"target":"Piove.","ref":"It's raining.","note":"from piovere"},
{"target":"Nevica.","ref":"It's snowing.","note":"from nevicare"},
{"target":"C'è vento.","ref":"It's windy.","note":"il vento = wind"},
{"target":"È nuvoloso.","ref":"It's cloudy.","note":"la nuvola = cloud"},
{"target":"Che bella giornata!","ref":"What a lovely day!","note":"la giornata = the whole day"},
{"target":"Tutto bene?","ref":"All good?","note":"friendly check-in"},
{"target":"Non c'è male.","ref":"Not bad.","note":"common reply to Come va?"},
{"target":"A dopo!","ref":"See you later!","note":"casual sign-off"}
]},
{"name":"Family Members","items":[
{"target":"la madre / la mamma","ref":"mother / mom","note":"mamma is affectionate"},
{"target":"il padre / il papà","ref":"father / dad","note":"papà with final accent"},
{"target":"il figlio","ref":"son","note":"i figli = children/sons"},
{"target":"la figlia","ref":"daughter","note":"le figlie = daughters"},
{"target":"il fratello","ref":"brother","note":"fra-TEL-lo"},
{"target":"la sorella","ref":"sister","note":"so-REL-la"},
{"target":"i genitori","ref":"parents","note":"il genitore = parent"},
{"target":"il nonno / la nonna","ref":"grandfather / grandmother","note":"i nonni = grandparents"},
{"target":"il marito","ref":"husband","note":"ma-REE-to"},
{"target":"la moglie","ref":"wife","note":"MOL-yeh"},
{"target":"lo zio / la zia","ref":"uncle / aunt","note":"gli zii = uncles/aunts"},
{"target":"il cugino / la cugina","ref":"cousin (m/f)","note":"koo-JEE-no"}
]},
{"name":"Polite Requests & Etiquette","items":[
{"target":"per favore / per piacere","ref":"please","note":"both are common"},
{"target":"grazie","ref":"thank you","note":"grazie mille = thanks a lot"},
{"target":"prego","ref":"you're welcome / go ahead","note":"reply to grazie; also 'after you'"},
{"target":"di niente","ref":"you're welcome (it's nothing)","note":"also: figurati (informal)"},
{"target":"scusi","ref":"excuse me (formal)","note":"informal: scusa"},
{"target":"mi dispiace","ref":"I'm sorry","note":"for regret/sympathy"},
{"target":"permesso","ref":"may I come in / through?","note":"said entering or squeezing past"},
{"target":"Le dispiace se...?","ref":"Do you mind if...? (formal)","note":"polite request for permission"},
{"target":"Potrebbe...?","ref":"Could you...? (formal)","note":"conditional of potere"},
{"target":"Volentieri!","ref":"Gladly! / With pleasure!","note":"enthusiastic yes"},
{"target":"Si figuri.","ref":"Don't mention it. (formal)","note":"reassuring reply"},
{"target":"Mi scusi, non volevo.","ref":"I'm sorry, I didn't mean to.","note":"apology after a small mistake"}
]}
]}
