{"categories":[
{"name":"Greetings & Polite Expressions","items":[
{"target":"おはようございます","ref":"Good morning (polite)","note":"ohayō gozaimasu; drop gozaimasu with friends"},
{"target":"こんにちは","ref":"Hello / Good afternoon","note":"konnichiwa; は here is read 'wa'"},
{"target":"こんばんは","ref":"Good evening","note":"konbanwa; used after dark"},
{"target":"はじめまして","ref":"Nice to meet you","note":"hajimemashite; lit. 'for the first time'"},
{"target":"よろしくお願いします","ref":"Please treat me well / Thanks in advance","note":"yoroshiku onegai shimasu; essential after introductions"},
{"target":"ありがとうございます","ref":"Thank you","note":"arigatō gozaimasu; past ありがとうございました for a finished favor"},
{"target":"すみません","ref":"Excuse me / Sorry / Thanks","note":"sumimasen; all-purpose apology and attention-getter"},
{"target":"ごめんなさい","ref":"I'm sorry","note":"gomen nasai; casual ごめん among friends"},
{"target":"さようなら","ref":"Goodbye","note":"sayōnara; formal; casual is じゃあね (jā ne)"},
{"target":"おやすみなさい","ref":"Good night","note":"oyasumi nasai; casual おやすみ"},
{"target":"いってきます","ref":"I'm off (and coming back)","note":"ittekimasu; said when leaving home; reply いってらっしゃい"},
{"target":"ただいま","ref":"I'm home","note":"tadaima; reply is おかえりなさい (okaeri nasai)"}
]},
{"name":"Numbers 1–20 + 100/1000/10000","items":[
{"target":"一 (いち)","ref":"1","note":"ichi"},
{"target":"二 (に)","ref":"2","note":"ni"},
{"target":"三 (さん)","ref":"3","note":"san"},
{"target":"四 (よん / し)","ref":"4","note":"yon or shi; yon avoids the 'death' homophone"},
{"target":"五 (ご)","ref":"5","note":"go"},
{"target":"六 (ろく)","ref":"6","note":"roku"},
{"target":"七 (なな / しち)","ref":"7","note":"nana or shichi"},
{"target":"八 (はち)","ref":"8","note":"hachi"},
{"target":"九 (きゅう / く)","ref":"9","note":"kyū or ku"},
{"target":"十 (じゅう)","ref":"10","note":"jū; 11=十一 jūichi, 20=二十 nijū"},
{"target":"百 (ひゃく)","ref":"100","note":"hyaku; 300=三百 sanbyaku, 600=六百 roppyaku"},
{"target":"千 (せん) / 万 (まん)","ref":"1,000 / 10,000","note":"sen / man; 10,000 is one 'man' unit, key to Japanese counting"}
]},
{"name":"Days, Months & Time Expressions","items":[
{"target":"月曜日 (げつようび)","ref":"Monday","note":"getsuyōbi; 月 = moon"},
{"target":"火曜日 (かようび)","ref":"Tuesday","note":"kayōbi; 火 = fire"},
{"target":"水曜日 (すいようび)","ref":"Wednesday","note":"suiyōbi; 水 = water"},
{"target":"木曜日 (もくようび)","ref":"Thursday","note":"mokuyōbi; 木 = wood"},
{"target":"金曜日 (きんようび)","ref":"Friday","note":"kinyōbi; 金 = gold/money"},
{"target":"土曜日 (どようび)","ref":"Saturday","note":"doyōbi; 土 = earth"},
{"target":"日曜日 (にちようび)","ref":"Sunday","note":"nichiyōbi; 日 = sun"},
{"target":"今日 (きょう)","ref":"today","note":"kyō; irregular reading"},
{"target":"明日 (あした)","ref":"tomorrow","note":"ashita"},
{"target":"昨日 (きのう)","ref":"yesterday","note":"kinō"},
{"target":"一月・二月 (いちがつ・にがつ)","ref":"January / February","note":"months = number + 月 (gatsu); April=四月 shigatsu"},
{"target":"毎日 (まいにち)","ref":"every day","note":"mainichi; 毎週 maishū every week, 毎年 maitoshi every year"}
]},
{"name":"Essential Verbs (ます form)","items":[
{"target":"います","ref":"to be / exist (animate)","note":"imasu; for people and animals"},
{"target":"あります","ref":"to be / exist (inanimate)","note":"arimasu; for objects and plants"},
{"target":"します","ref":"to do","note":"shimasu; irregular verb する"},
{"target":"いきます","ref":"to go","note":"ikimasu; 行きます"},
{"target":"きます","ref":"to come","note":"kimasu; 来ます, irregular"},
{"target":"たべます","ref":"to eat","note":"tabemasu; 食べます"},
{"target":"のみます","ref":"to drink","note":"nomimasu; 飲みます"},
{"target":"みます","ref":"to see / watch","note":"mimasu; 見ます"},
{"target":"ききます","ref":"to listen / ask","note":"kikimasu; 聞きます"},
{"target":"かいます","ref":"to buy","note":"kaimasu; 買います"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"何 (なに / なん)","ref":"what","note":"nani / nan; なん before counters (何時 nanji)"},
{"target":"誰 (だれ)","ref":"who","note":"dare; polite どなた donata"},
{"target":"いつ","ref":"when","note":"itsu"},
{"target":"どこ","ref":"where","note":"doko; polite どちら dochira"},
{"target":"どうして / なぜ","ref":"why","note":"dōshite / naze; casual なんで nande"},
{"target":"どう","ref":"how","note":"dō"},
{"target":"いくら","ref":"how much (price)","note":"ikura"},
{"target":"どれ / どの","ref":"which one / which","note":"dore / dono; どの needs a noun"},
{"target":"そして","ref":"and then","note":"soshite; connects sentences"},
{"target":"でも","ref":"but / however","note":"demo; sentence-initial"},
{"target":"だから","ref":"so / therefore","note":"dakara"},
{"target":"それから","ref":"after that","note":"sorekara"}
]},
{"name":"Survival Phrases","items":[
{"target":"英語が話せますか。","ref":"Can you speak English?","note":"Eigo ga hanasemasu ka"},
{"target":"わかりません。","ref":"I don't understand.","note":"wakarimasen"},
{"target":"もう一度お願いします。","ref":"One more time, please.","note":"mō ichido onegai shimasu"},
{"target":"ゆっくり話してください。","ref":"Please speak slowly.","note":"yukkuri hanashite kudasai"},
{"target":"トイレはどこですか。","ref":"Where is the toilet?","note":"toire wa doko desu ka"},
{"target":"助けてください。","ref":"Please help me.","note":"tasukete kudasai"},
{"target":"駅はどこですか。","ref":"Where is the station?","note":"eki wa doko desu ka"},
{"target":"これをください。","ref":"I'll take this, please.","note":"kore o kudasai"},
{"target":"いくらですか。","ref":"How much is it?","note":"ikura desu ka"},
{"target":"大丈夫です。","ref":"It's fine / No thanks.","note":"daijōbu desu; also declines an offer"},
{"target":"ちょっと待ってください。","ref":"Please wait a moment.","note":"chotto matte kudasai"}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"今、何時ですか。","ref":"What time is it now?","note":"ima, nanji desu ka"},
{"target":"一時 (いちじ)","ref":"one o'clock","note":"ichiji; hour = number + 時 (ji)"},
{"target":"四時 (よじ)","ref":"four o'clock","note":"yoji; irregular — not yonji"},
{"target":"七時 (しちじ)","ref":"seven o'clock","note":"shichiji"},
{"target":"九時 (くじ)","ref":"nine o'clock","note":"kuji; irregular — not kyūji"},
{"target":"〜分 (ふん / ぷん)","ref":"minutes","note":"fun/pun; 一分 ippun, 三分 sanpun"},
{"target":"半 (はん)","ref":"half past","note":"han; 三時半 sanji han = 3:30"},
{"target":"午前 / 午後","ref":"a.m. / p.m.","note":"gozen / gogo; precede the hour"},
{"target":"朝 (あさ)","ref":"morning","note":"asa"},
{"target":"昼 (ひる)","ref":"noon / daytime","note":"hiru"},
{"target":"夜 (よる)","ref":"night","note":"yoru"},
{"target":"〜から〜まで","ref":"from ~ to ~","note":"kara ~ made; 九時から五時まで 9 to 5"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"大きい ⇔ 小さい","ref":"big ⇔ small","note":"ōkii ⇔ chiisai (both い-adj)"},
{"target":"高い ⇔ 安い","ref":"expensive ⇔ cheap","note":"takai ⇔ yasui"},
{"target":"高い ⇔ 低い","ref":"tall/high ⇔ low","note":"takai ⇔ hikui"},
{"target":"新しい ⇔ 古い","ref":"new ⇔ old","note":"atarashii ⇔ furui"},
{"target":"暑い ⇔ 寒い","ref":"hot ⇔ cold (weather)","note":"atsui ⇔ samui"},
{"target":"新しい ⇔ 難しい","ref":"easy ⇔ difficult","note":"yasashii ⇔ muzukashii"},
{"target":"おいしい ⇔ まずい","ref":"tasty ⇔ bad-tasting","note":"oishii ⇔ mazui"},
{"target":"いい ⇔ 悪い","ref":"good ⇔ bad","note":"ii ⇔ warui; いい is irregular (よくない)"},
{"target":"早い ⇔ 遅い","ref":"early/fast ⇔ late/slow","note":"hayai ⇔ osoi"},
{"target":"きれい ⇔ 汚い","ref":"clean/pretty ⇔ dirty","note":"kirei (な-adj) ⇔ kitanai (い-adj)"},
{"target":"元気 ⇔ 疲れた","ref":"energetic ⇔ tired","note":"genki (な-adj) ⇔ tsukareta"},
{"target":"静か ⇔ うるさい","ref":"quiet ⇔ noisy","note":"shizuka (な-adj) ⇔ urusai (い-adj)"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"メニューをください。","ref":"The menu, please.","note":"menyū o kudasai"},
{"target":"これは何ですか。","ref":"What is this?","note":"kore wa nan desu ka"},
{"target":"おすすめは何ですか。","ref":"What do you recommend?","note":"osusume wa nan desu ka"},
{"target":"これをお願いします。","ref":"I'll have this, please.","note":"kore o onegai shimasu"},
{"target":"水をください。","ref":"Water, please.","note":"mizu o kudasai; tap water is free"},
{"target":"いただきます","ref":"Thanks for the meal (before eating)","note":"itadakimasu; said before every meal"},
{"target":"ごちそうさまでした","ref":"Thanks for the meal (after)","note":"gochisōsama deshita"},
{"target":"お会計をお願いします。","ref":"The bill, please.","note":"okaikei o onegai shimasu"},
{"target":"別々でお願いします。","ref":"Separate checks, please.","note":"betsubetsu de onegai shimasu"},
{"target":"辛いですか。","ref":"Is it spicy?","note":"karai desu ka"},
{"target":"アレルギーがあります。","ref":"I have an allergy.","note":"arerugī ga arimasu"},
{"target":"とてもおいしかったです。","ref":"It was very delicious.","note":"totemo oishikatta desu"}
]},
{"name":"Shopping & Money","items":[
{"target":"これはいくらですか。","ref":"How much is this?","note":"kore wa ikura desu ka"},
{"target":"試着してもいいですか。","ref":"May I try it on?","note":"shichaku shite mo ii desu ka"},
{"target":"もっと大きいのはありますか。","ref":"Do you have a bigger one?","note":"motto ōkii no wa arimasu ka"},
{"target":"別の色はありますか。","ref":"Do you have another color?","note":"betsu no iro wa arimasu ka"},
{"target":"高すぎます。","ref":"It's too expensive.","note":"takasugimasu"},
{"target":"カードで払えますか。","ref":"Can I pay by card?","note":"kādo de haraemasu ka"},
{"target":"現金でお願いします。","ref":"Cash, please.","note":"genkin de onegai shimasu"},
{"target":"袋をください。","ref":"A bag, please.","note":"fukuro o kudasai"},
{"target":"これをください。","ref":"I'll take this.","note":"kore o kudasai"},
{"target":"レシートをください。","ref":"A receipt, please.","note":"reshīto o kudasai"},
{"target":"少し安くなりますか。","ref":"Can it be a little cheaper?","note":"sukoshi yasuku narimasu ka; rare in Japan"},
{"target":"消費税込みですか。","ref":"Is tax included?","note":"shōhizei komi desu ka"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"いい天気ですね。","ref":"Nice weather, isn't it?","note":"ii tenki desu ne; classic ice-breaker"},
{"target":"暑いですね。","ref":"It's hot, isn't it?","note":"atsui desu ne"},
{"target":"寒いですね。","ref":"It's cold, isn't it?","note":"samui desu ne"},
{"target":"雨が降っています。","ref":"It's raining.","note":"ame ga futte imasu"},
{"target":"雪が降りそうです。","ref":"It looks like it'll snow.","note":"yuki ga furisō desu"},
{"target":"傘が要りますか。","ref":"Do you need an umbrella?","note":"kasa ga irimasu ka"},
{"target":"今日は蒸し暑いです。","ref":"It's humid today.","note":"kyō wa mushiatsui desu"},
{"target":"風が強いです。","ref":"The wind is strong.","note":"kaze ga tsuyoi desu"},
{"target":"お元気ですか。","ref":"How are you?","note":"ogenki desu ka; not used daily like English"},
{"target":"おかげさまで。","ref":"I'm fine, thanks (to you).","note":"okagesama de; humble set reply"},
{"target":"最近どうですか。","ref":"How've you been lately?","note":"saikin dō desu ka"},
{"target":"そうですね。","ref":"That's right / Let me see.","note":"sō desu ne; agreement or thinking pause"}
]},
{"name":"Family Members","items":[
{"target":"父 (ちち) / お父さん","ref":"my father / (your) father","note":"chichi (own) / otōsan (others', polite)"},
{"target":"母 (はは) / お母さん","ref":"my mother / (your) mother","note":"haha (own) / okāsan (others')"},
{"target":"兄 (あに) / お兄さん","ref":"my older brother / (your)","note":"ani / onīsan"},
{"target":"姉 (あね) / お姉さん","ref":"my older sister / (your)","note":"ane / onēsan"},
{"target":"弟 (おとうと)","ref":"younger brother","note":"otōto; polite 弟さん otōtosan"},
{"target":"妹 (いもうと)","ref":"younger sister","note":"imōto; polite 妹さん imōtosan"},
{"target":"祖父 (そふ) / おじいさん","ref":"my grandfather / (your)","note":"sofu / ojiisan"},
{"target":"祖母 (そぼ) / おばあさん","ref":"my grandmother / (your)","note":"sobo / obāsan"},
{"target":"両親 (りょうしん)","ref":"parents","note":"ryōshin; ご両親 goryōshin for others'"},
{"target":"兄弟 (きょうだい)","ref":"siblings","note":"kyōdai"},
{"target":"家族 (かぞく)","ref":"family","note":"kazoku; ご家族 gokazoku for others'"},
{"target":"夫 (おっと) / 妻 (つま)","ref":"husband / wife","note":"otto / tsuma (own); ご主人 goshujin / 奥さん okusan for others'"}
]}
]}
