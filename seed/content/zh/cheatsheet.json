{"categories":[
{"name":"Greetings & Polite Phrases","items":[
{"target":"你好","ref":"Hello","note":"nǐ hǎo — literally 'you good'; the default greeting"},
{"target":"您好","ref":"Hello (polite)","note":"nín hǎo — 您 is the respectful 'you' for elders/strangers"},
{"target":"早上好","ref":"Good morning","note":"zǎoshang hǎo"},
{"target":"谢谢","ref":"Thank you","note":"xièxie — second syllable neutral tone"},
{"target":"不客气","ref":"You're welcome","note":"bú kèqi — literally 'don't be polite'"},
{"target":"对不起","ref":"Sorry","note":"duìbuqǐ"},
{"target":"没关系","ref":"It's okay / no problem","note":"méi guānxi — reply to an apology"},
{"target":"再见","ref":"Goodbye","note":"zàijiàn — literally 'again see'"},
{"target":"请问","ref":"Excuse me (may I ask)","note":"qǐngwèn — polite lead-in to a question"},
{"target":"欢迎","ref":"Welcome","note":"huānyíng"},
{"target":"好久不见","ref":"Long time no see","note":"hǎojiǔ bú jiàn"},
{"target":"晚安","ref":"Good night","note":"wǎn'ān"}
]},
{"name":"Numbers 1–20 and Big Numbers","items":[
{"target":"一","ref":"one","note":"yī"},
{"target":"二","ref":"two","note":"èr — but 两 (liǎng) before measure words"},
{"target":"三","ref":"three","note":"sān"},
{"target":"五","ref":"five","note":"wǔ"},
{"target":"十","ref":"ten","note":"shí"},
{"target":"十一","ref":"eleven","note":"shíyī — literally 'ten-one'"},
{"target":"十五","ref":"fifteen","note":"shíwǔ"},
{"target":"二十","ref":"twenty","note":"èrshí — 'two-ten'"},
{"target":"一百","ref":"one hundred","note":"yìbǎi"},
{"target":"一千","ref":"one thousand","note":"yìqiān"},
{"target":"一万","ref":"ten thousand","note":"yíwàn — Chinese groups by 万 (10,000), not by thousand"},
{"target":"零","ref":"zero","note":"líng"}
]},
{"name":"Days, Months & Time","items":[
{"target":"今天","ref":"today","note":"jīntiān"},
{"target":"明天","ref":"tomorrow","note":"míngtiān"},
{"target":"昨天","ref":"yesterday","note":"zuótiān"},
{"target":"星期一","ref":"Monday","note":"xīngqīyī — days = 星期 + number; 星期日/天 = Sunday"},
{"target":"星期六","ref":"Saturday","note":"xīngqīliù"},
{"target":"一月","ref":"January","note":"yīyuè — months = number + 月"},
{"target":"十二月","ref":"December","note":"shí'èryuè"},
{"target":"现在","ref":"now","note":"xiànzài"},
{"target":"早上","ref":"morning","note":"zǎoshang"},
{"target":"晚上","ref":"evening / night","note":"wǎnshang"},
{"target":"号","ref":"day of month","note":"hào — 五号 = the 5th; also 日 (rì) in writing"},
{"target":"点","ref":"o'clock","note":"diǎn — 三点 = 3 o'clock"}
]},
{"name":"Essential Verbs","items":[
{"target":"是","ref":"to be","note":"shì — links two nouns: 我是学生"},
{"target":"有","ref":"to have / there is","note":"yǒu — negate with 没有, never 不有"},
{"target":"在","ref":"to be at / -ing location","note":"zài — 我在家 (I'm at home)"},
{"target":"去","ref":"to go","note":"qù"},
{"target":"来","ref":"to come","note":"lái"},
{"target":"做","ref":"to do / make","note":"zuò"},
{"target":"说","ref":"to speak / say","note":"shuō"},
{"target":"要","ref":"to want / will","note":"yào"},
{"target":"可以","ref":"can / may","note":"kěyǐ — permission"},
{"target":"喜欢","ref":"to like","note":"xǐhuan — second syllable neutral tone"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"什么","ref":"what","note":"shénme"},
{"target":"谁","ref":"who","note":"shéi (also shuí)"},
{"target":"哪里","ref":"where","note":"nǎlǐ — also 哪儿 nǎr in the north"},
{"target":"什么时候","ref":"when","note":"shénme shíhou"},
{"target":"为什么","ref":"why","note":"wèishénme"},
{"target":"怎么","ref":"how","note":"zěnme"},
{"target":"几","ref":"how many (small)","note":"jǐ — needs a measure word: 几个"},
{"target":"多少","ref":"how much / how many","note":"duōshao — for larger or unknown amounts"},
{"target":"和","ref":"and (nouns)","note":"hé — joins nouns, not clauses"},
{"target":"但是","ref":"but","note":"dànshì"},
{"target":"因为","ref":"because","note":"yīnwèi — pairs with 所以"},
{"target":"所以","ref":"so / therefore","note":"suǒyǐ"}
]},
{"name":"Survival Phrases","items":[
{"target":"多少钱?","ref":"How much is it?","note":"duōshao qián?"},
{"target":"太贵了","ref":"Too expensive","note":"tài guì le"},
{"target":"我要这个","ref":"I want this one","note":"wǒ yào zhège"},
{"target":"洗手间在哪里?","ref":"Where is the bathroom?","note":"xǐshǒujiān zài nǎlǐ?"},
{"target":"我不明白","ref":"I don't understand","note":"wǒ bù míngbai"},
{"target":"请再说一遍","ref":"Please say it again","note":"qǐng zài shuō yí biàn"},
{"target":"你会说英文吗?","ref":"Do you speak English?","note":"nǐ huì shuō Yīngwén ma?"},
{"target":"帮帮我","ref":"Help me","note":"bāngbang wǒ"},
{"target":"我要买单","ref":"I'd like the bill","note":"wǒ yào mǎidān — in a restaurant"},
{"target":"怎么走?","ref":"How do I get there?","note":"zěnme zǒu?"},
{"target":"这是什么?","ref":"What is this?","note":"zhè shì shénme?"},
{"target":"我不要","ref":"I don't want it","note":"wǒ bú yào"}
]},
{"name":"Telling the Clock","items":[
{"target":"几点了?","ref":"What time is it?","note":"jǐ diǎn le?"},
{"target":"三点","ref":"3:00","note":"sān diǎn"},
{"target":"三点半","ref":"3:30","note":"sān diǎn bàn — 半 = half"},
{"target":"三点一刻","ref":"3:15","note":"sān diǎn yí kè — 刻 = quarter hour"},
{"target":"差一刻四点","ref":"3:45 (quarter to four)","note":"chà yí kè sì diǎn — 差 = short of"},
{"target":"两点十分","ref":"2:10","note":"liǎng diǎn shí fēn — use 两 for 2 o'clock, 分 = minute"},
{"target":"中午","ref":"noon","note":"zhōngwǔ"},
{"target":"半夜","ref":"midnight","note":"bànyè"},
{"target":"上午","ref":"late morning / a.m.","note":"shàngwǔ"},
{"target":"下午","ref":"afternoon / p.m.","note":"xiàwǔ"},
{"target":"分钟","ref":"minute (duration)","note":"fēnzhōng — 十分钟 = ten minutes"},
{"target":"小时","ref":"hour (duration)","note":"xiǎoshí — 一个小时 = one hour"}
]},
{"name":"Adjectives & Opposites","items":[
{"target":"大 / 小","ref":"big / small","note":"dà / xiǎo"},
{"target":"多 / 少","ref":"many / few","note":"duō / shǎo"},
{"target":"高 / 矮","ref":"tall / short (height)","note":"gāo / ǎi"},
{"target":"长 / 短","ref":"long / short (length)","note":"cháng / duǎn"},
{"target":"新 / 旧","ref":"new / old (things)","note":"xīn / jiù"},
{"target":"快 / 慢","ref":"fast / slow","note":"kuài / màn"},
{"target":"好 / 坏","ref":"good / bad","note":"hǎo / huài"},
{"target":"贵 / 便宜","ref":"expensive / cheap","note":"guì / piányi"},
{"target":"热 / 冷","ref":"hot / cold","note":"rè / lěng"},
{"target":"难 / 容易","ref":"difficult / easy","note":"nán / róngyì"},
{"target":"忙 / 闲","ref":"busy / free","note":"máng / xián"},
{"target":"远 / 近","ref":"far / near","note":"yuǎn / jìn"}
]},
{"name":"Food & Restaurant","items":[
{"target":"菜单","ref":"menu","note":"càidān"},
{"target":"服务员","ref":"waiter / server","note":"fúwùyuán — call one with 服务员!"},
{"target":"我要点菜","ref":"I'd like to order","note":"wǒ yào diǎn cài"},
{"target":"米饭","ref":"cooked rice","note":"mǐfàn"},
{"target":"茶","ref":"tea","note":"chá"},
{"target":"水","ref":"water","note":"shuǐ"},
{"target":"啤酒","ref":"beer","note":"píjiǔ"},
{"target":"辣","ref":"spicy","note":"là — 不要辣 = not spicy"},
{"target":"好吃","ref":"delicious (food)","note":"hǎochī — literally 'good to eat'"},
{"target":"我吃素","ref":"I'm vegetarian","note":"wǒ chī sù"},
{"target":"买单","ref":"the bill / check please","note":"mǎidān — also 结账 jiézhàng"},
{"target":"打包","ref":"to take away / pack up","note":"dǎbāo"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"今天天气怎么样?","ref":"How's the weather today?","note":"jīntiān tiānqì zěnmeyàng?"},
{"target":"下雨了","ref":"It's raining","note":"xià yǔ le"},
{"target":"下雪","ref":"to snow","note":"xià xuě"},
{"target":"很热","ref":"very hot","note":"hěn rè"},
{"target":"很冷","ref":"very cold","note":"hěn lěng"},
{"target":"晴天","ref":"sunny day","note":"qíngtiān"},
{"target":"阴天","ref":"cloudy / overcast","note":"yīntiān"},
{"target":"刮风","ref":"windy (wind blows)","note":"guā fēng"},
{"target":"你最近怎么样?","ref":"How have you been lately?","note":"nǐ zuìjìn zěnmeyàng?"},
{"target":"还好","ref":"pretty good / so-so","note":"hái hǎo"},
{"target":"很忙","ref":"very busy","note":"hěn máng"},
{"target":"你呢?","ref":"And you?","note":"nǐ ne? — bounce a question back"}
]},
{"name":"Family Members","items":[
{"target":"爸爸","ref":"dad","note":"bàba"},
{"target":"妈妈","ref":"mom","note":"māma"},
{"target":"哥哥","ref":"older brother","note":"gēge"},
{"target":"弟弟","ref":"younger brother","note":"dìdi — age is built into the word"},
{"target":"姐姐","ref":"older sister","note":"jiějie"},
{"target":"妹妹","ref":"younger sister","note":"mèimei"},
{"target":"爷爷","ref":"paternal grandpa","note":"yéye — father's father"},
{"target":"奶奶","ref":"paternal grandma","note":"nǎinai — father's mother"},
{"target":"外公","ref":"maternal grandpa","note":"wàigōng — mother's father"},
{"target":"外婆","ref":"maternal grandma","note":"wàipó — mother's mother"},
{"target":"儿子","ref":"son","note":"érzi"},
{"target":"女儿","ref":"daughter","note":"nǚ'ér"}
]},
{"name":"Polite Requests & Etiquette","items":[
{"target":"请","ref":"please","note":"qǐng — put it at the front: 请坐"},
{"target":"请坐","ref":"Please sit","note":"qǐng zuò"},
{"target":"请问一下","ref":"May I ask something","note":"qǐng wèn yíxià"},
{"target":"麻烦你","ref":"May I trouble you / excuse me","note":"máfan nǐ — polite request lead-in"},
{"target":"可以吗?","ref":"Is that okay? / May I?","note":"kěyǐ ma?"},
{"target":"没问题","ref":"No problem","note":"méi wèntí"},
{"target":"劳驾","ref":"Excuse me (to pass/ask)","note":"láojià — polite, slightly formal"},
{"target":"辛苦了","ref":"Thanks for your effort","note":"xīnkǔ le — acknowledges someone's work"},
{"target":"不好意思","ref":"Sorry / excuse me (mild)","note":"bù hǎoyìsi — softer than 对不起"},
{"target":"请多关照","ref":"Please look after me","note":"qǐng duō guānzhào — polite when meeting new colleagues"},
{"target":"慢走","ref":"Take care (as guest leaves)","note":"màn zǒu — literally 'walk slowly'"},
{"target":"干杯","ref":"Cheers!","note":"gānbēi — literally 'dry the cup'"}
]}
]}
