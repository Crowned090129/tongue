{"categories":[
{"name":"Greetings & Social Phrases","items":[
{"target":"Hello / Hi","ref":"a standard / casual greeting","note":"'Hi' is informal; 'Hello' works in any situation."},
{"target":"Good morning","ref":"greeting used until about noon","note":"Switch to 'Good afternoon' after 12pm."},
{"target":"How are you?","ref":"asking about someone's wellbeing","note":"Common reply: 'I'm fine, thanks. And you?'"},
{"target":"Nice to meet you","ref":"said when meeting someone for the first time","note":"Reply: 'Nice to meet you too.'"},
{"target":"What's your name?","ref":"asking someone's name","note":"Answer: 'My name is...' or 'I'm...'"},
{"target":"Please","ref":"polite word with a request","note":"Add it to any request to sound polite."},
{"target":"Thank you / Thanks","ref":"expressing gratitude","note":"'Thanks' is the casual form; reply 'You're welcome.'"},
{"target":"Excuse me","ref":"getting attention or apologizing lightly","note":"Use to pass by someone or start a question."},
{"target":"I'm sorry","ref":"apologizing","note":"'Sorry' alone is fine for small things."},
{"target":"Goodbye / Bye","ref":"a farewell","note":"'Bye' is casual; 'See you later' is friendly."},
{"target":"See you tomorrow","ref":"farewell when you'll meet again soon","note":"Swap 'tomorrow' for 'later', 'soon', 'next week'."},
{"target":"Have a nice day","ref":"a friendly parting wish","note":"Reply: 'Thanks, you too!'"}
]},
{"name":"Numbers 1–20","items":[
{"target":"one","ref":"1","note":"pronounced 'wun'"},
{"target":"two","ref":"2","note":"the 'w' is silent: 'too'"},
{"target":"three","ref":"3","note":"'th' as in 'think'"},
{"target":"four","ref":"4","note":"sounds like 'for'"},
{"target":"five","ref":"5","note":"rhymes with 'hive'"},
{"target":"six","ref":"6","note":""},
{"target":"seven","ref":"7","note":"two syllables: SEV-en"},
{"target":"eight","ref":"8","note":"silent 'gh': 'ate'"},
{"target":"nine","ref":"9","note":"rhymes with 'line'"},
{"target":"ten","ref":"10","note":""},
{"target":"eleven","ref":"11","note":"e-LEV-en"},
{"target":"twelve","ref":"12","note":"irregular, not 'twoteen'"},
{"target":"thirteen","ref":"13","note":"stress the end: thir-TEEN"},
{"target":"fourteen","ref":"14","note":"keep the 'u': four-TEEN"},
{"target":"fifteen","ref":"15","note":"note 'fif', not 'five'"},
{"target":"sixteen","ref":"16","note":"six-TEEN"},
{"target":"seventeen","ref":"17","note":""},
{"target":"eighteen","ref":"18","note":"one 't': eigh-TEEN"},
{"target":"nineteen","ref":"19","note":"keep the 'e': nine-TEEN"},
{"target":"twenty","ref":"20","note":"TWEN-tee"}
]},
{"name":"Days, Months & Time Expressions","items":[
{"target":"Monday","ref":"first weekday","note":"Days are always capitalized in English."},
{"target":"Saturday / Sunday","ref":"the weekend","note":""},
{"target":"January","ref":"first month","note":"Months are always capitalized."},
{"target":"July","ref":"seventh month","note":""},
{"target":"December","ref":"twelfth month","note":""},
{"target":"today","ref":"this day","note":""},
{"target":"tomorrow","ref":"the next day","note":"note the double 'r'"},
{"target":"yesterday","ref":"the day before today","note":""},
{"target":"next week","ref":"the coming week","note":"Also 'next month', 'next year'."},
{"target":"last night","ref":"the previous evening","note":""},
{"target":"in the morning","ref":"during the early part of the day","note":"Also 'in the afternoon', 'in the evening'."},
{"target":"at the weekend","ref":"on Saturday and Sunday","note":"British 'at'; Americans say 'on the weekend'."},
{"target":"every day","ref":"daily","note":"Two words as an adverb; 'everyday' (one word) is an adjective."},
{"target":"right now","ref":"at this moment","note":""},
{"target":"a week ago","ref":"seven days in the past","note":"'ago' looks back from now."},
{"target":"soon","ref":"in a short time","note":""},
{"target":"later","ref":"after now","note":"'See you later.'"},
{"target":"in an hour","ref":"after sixty minutes","note":""},
{"target":"on time","ref":"punctual, not late","note":"'in time' means before a deadline."}
]},
{"name":"Essential Verbs (I / You / He)","items":[
{"target":"be — I am, you are, he is","ref":"exist / description","note":"Most irregular verb; memorize all forms."},
{"target":"have — I have, you have, he has","ref":"possess","note":"Only 'he/she/it' changes to 'has'."},
{"target":"do — I do, you do, he does","ref":"act / auxiliary","note":"'does' for he/she/it; also forms questions."},
{"target":"go — I go, you go, he goes","ref":"move to a place","note":"Past tense is irregular: 'went'."},
{"target":"get — I get, you get, he gets","ref":"obtain / become","note":"Very common; many meanings."},
{"target":"make — I make, you make, he makes","ref":"create / produce","note":"'make' vs 'do' confuses learners: make a cake, do homework."},
{"target":"know — I know, you know, he knows","ref":"have knowledge","note":"State verb — no continuous form."},
{"target":"think — I think, you think, he thinks","ref":"have an opinion / consider","note":"'I think' softens an opinion."},
{"target":"come — I come, you come, he comes","ref":"move toward the speaker","note":"Past is irregular: 'came'."},
{"target":"say — I say, you say, he says","ref":"speak words","note":"'says' is pronounced 'sez'."}
]},
{"name":"Question Words & Connectors","items":[
{"target":"what","ref":"asking about a thing","note":"'What is this?'"},
{"target":"who","ref":"asking about a person","note":"'Who called?'"},
{"target":"where","ref":"asking about a place","note":"'Where are you?'"},
{"target":"when","ref":"asking about a time","note":"'When does it start?'"},
{"target":"why","ref":"asking about a reason","note":"Answer with 'because'."},
{"target":"how","ref":"asking about manner or condition","note":"'How are you?' / 'How does it work?'"},
{"target":"which","ref":"asking to choose between options","note":"'Which one do you want?'"},
{"target":"and","ref":"adds information","note":""},
{"target":"but","ref":"shows contrast","note":""},
{"target":"because","ref":"gives a reason","note":"Answers 'why?'"},
{"target":"so","ref":"shows a result","note":"'It rained, so we stayed home.'"},
{"target":"or","ref":"presents an alternative","note":""}
]},
{"name":"Survival Phrases (Formal)","items":[
{"target":"Could you help me, please?","ref":"a polite request for help","note":"'Could' is more polite than 'can'."},
{"target":"I would like...","ref":"stating a want politely","note":"Softer than 'I want'. Often shortened to 'I'd like'."},
{"target":"Excuse me, where is...?","ref":"asking for directions politely","note":""},
{"target":"Do you speak English?","ref":"checking a common language","note":""},
{"target":"Could you repeat that, please?","ref":"asking for a repeat","note":"Or: 'Sorry, could you say that again?'"},
{"target":"May I speak to...?","ref":"asking for someone on the phone","note":"Formal phone opener."},
{"target":"I'm calling about...","ref":"stating the reason for a call","note":""},
{"target":"Could you hold on a moment?","ref":"asking someone to wait on the phone","note":""},
{"target":"I look forward to hearing from you","ref":"polite email closing","note":"Common before a formal sign-off."},
{"target":"Best regards,","ref":"a formal email sign-off","note":"Follow with your name."},
{"target":"Please find attached...","ref":"referring to an email attachment","note":""},
{"target":"Thank you for your time","ref":"polite closing of a request","note":""},
{"target":"I'm sorry to bother you","ref":"a polite interruption","note":""},
{"target":"Would it be possible to...?","ref":"a very polite request","note":""},
{"target":"Please let me know","ref":"asking for a reply","note":""}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"What time is it?","ref":"asking the time","note":"Also: 'Do you have the time?'"},
{"target":"It's three o'clock","ref":"3:00 exactly","note":"Only use 'o'clock' on the exact hour."},
{"target":"It's half past four","ref":"4:30","note":"Americans often say 'four thirty'."},
{"target":"It's quarter past six","ref":"6:15","note":"'a quarter past' = 15 minutes after."},
{"target":"It's quarter to nine","ref":"8:45","note":"'to' = minutes before the next hour."},
{"target":"It's ten past five","ref":"5:10","note":""},
{"target":"It's twenty to eight","ref":"7:40","note":""},
{"target":"noon / midday","ref":"12:00 in the day","note":""},
{"target":"midnight","ref":"12:00 at night","note":""},
{"target":"a.m.","ref":"before noon","note":"from Latin 'ante meridiem'"},
{"target":"p.m.","ref":"after noon","note":"from Latin 'post meridiem'"},
{"target":"It's about seven","ref":"approximately 7:00","note":"'about' / 'around' = roughly."}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"big / small","ref":"large size / little size","note":""},
{"target":"good / bad","ref":"positive / negative quality","note":"Comparatives are irregular: better/worse."},
{"target":"hot / cold","ref":"high / low temperature","note":""},
{"target":"new / old","ref":"recent / not recent","note":"'old' also = aged, for people."},
{"target":"fast / slow","ref":"high / low speed","note":""},
{"target":"easy / difficult","ref":"simple / hard to do","note":"'hard' is a synonym of 'difficult'."},
{"target":"happy / sad","ref":"positive / negative emotion","note":""},
{"target":"cheap / expensive","ref":"low / high price","note":""},
{"target":"clean / dirty","ref":"free of / covered in dirt","note":""},
{"target":"early / late","ref":"before / after the expected time","note":""},
{"target":"open / closed","ref":"accessible / not accessible","note":""},
{"target":"full / empty","ref":"containing much / nothing","note":""},
{"target":"strong / weak","ref":"much / little power","note":""},
{"target":"light / heavy","ref":"low / high weight","note":"'light' also = not dark."},
{"target":"right / wrong","ref":"correct / incorrect","note":"'right' also = the opposite of left."},
{"target":"near / far","ref":"close / distant","note":""}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"A table for two, please","ref":"asking for a table","note":"Change the number as needed."},
{"target":"Can I see the menu?","ref":"requesting the menu","note":"Also: 'Could we have the menu?'"},
{"target":"I'd like the chicken, please","ref":"ordering a dish","note":"'I'd like' is polite for ordering."},
{"target":"What do you recommend?","ref":"asking for a suggestion","note":""},
{"target":"I'm a vegetarian","ref":"stating a dietary need","note":"Also: 'I don't eat meat.'"},
{"target":"Is this dish spicy?","ref":"asking about a dish","note":""},
{"target":"Can I have some water?","ref":"requesting a drink","note":"'still' = no bubbles, 'sparkling' = fizzy."},
{"target":"The bill, please","ref":"asking to pay","note":"Americans say 'the check'."},
{"target":"Can I pay by card?","ref":"asking about payment method","note":""},
{"target":"Keep the change","ref":"leaving a tip","note":""},
{"target":"It was delicious","ref":"complimenting the food","note":""},
{"target":"I'm allergic to nuts","ref":"warning about an allergy","note":"Swap 'nuts' for any allergen."},
{"target":"Enjoy your meal","ref":"said before eating","note":"Reply: 'Thank you, you too.'"},
{"target":"Cheers!","ref":"a toast before drinking","note":"In Britain 'cheers' also means 'thanks'."},
{"target":"Could we get separate bills?","ref":"asking to split the cost","note":"Or: 'Can we split the bill?'"}
]},
{"name":"Shopping & Money","items":[
{"target":"How much is this?","ref":"asking a price","note":"For plural: 'How much are these?'"},
{"target":"How much does it cost?","ref":"asking the cost","note":""},
{"target":"Do you have this in a larger size?","ref":"asking about sizes","note":"Swap for 'smaller', 'another color'."},
{"target":"Can I try it on?","ref":"asking to test clothing","note":""},
{"target":"Where is the fitting room?","ref":"asking where to try clothes","note":""},
{"target":"It's too expensive","ref":"saying the price is high","note":"'too' = more than acceptable."},
{"target":"Is there a discount?","ref":"asking for a lower price","note":""},
{"target":"I'm just looking, thanks","ref":"declining help politely","note":"Common reply to a shop assistant."},
{"target":"I'll take it","ref":"deciding to buy","note":""},
{"target":"Can I pay in cash?","ref":"asking about payment","note":"Opposite: 'by card'."},
{"target":"Can I have a receipt?","ref":"requesting proof of purchase","note":""},
{"target":"Can I get a refund?","ref":"asking for your money back","note":"Related: 'exchange' = swap for another item."},
{"target":"It's on sale","ref":"the item is discounted","note":""},
{"target":"That's a good deal","ref":"the price is worth it","note":""}
]},
{"name":"Weather & Small Talk","items":[
{"target":"It's sunny today","ref":"the sun is shining","note":"Add '-y' to many weather nouns: sun→sunny."},
{"target":"It's raining","ref":"rain is falling","note":"Note the -ing form for current weather."},
{"target":"It's cold","ref":"low temperature","note":"'freezing' = very cold."},
{"target":"It's hot","ref":"high temperature","note":"'boiling' = very hot."},
{"target":"It's windy","ref":"there is a lot of wind","note":""},
{"target":"It's cloudy","ref":"the sky is grey","note":""},
{"target":"What's the weather like?","ref":"asking about the weather","note":"'like' here means 'how is it'."},
{"target":"Lovely weather today, isn't it?","ref":"a classic small-talk opener","note":"Question tag invites agreement."},
{"target":"How's it going?","ref":"a casual 'how are you'","note":"Reply: 'Not bad, thanks.'"},
{"target":"Did you have a good weekend?","ref":"friendly small talk","note":""},
{"target":"How's work?","ref":"asking about someone's job","note":""},
{"target":"Take care","ref":"a friendly goodbye","note":""},
{"target":"It looks like rain","ref":"predicting rain from the sky","note":""},
{"target":"Long time no see","ref":"greeting after a long absence","note":"Fixed informal phrase."}
]},
{"name":"Family Members","items":[
{"target":"mother / mum","ref":"female parent","note":"'mum' (UK) / 'mom' (US) are casual."},
{"target":"father / dad","ref":"male parent","note":"'dad' is casual."},
{"target":"parents","ref":"mother and father together","note":""},
{"target":"sister","ref":"female sibling","note":""},
{"target":"brother","ref":"male sibling","note":""},
{"target":"son","ref":"male child","note":"pronounced like 'sun'"},
{"target":"daughter","ref":"female child","note":"silent 'gh': 'DAW-ter'"},
{"target":"grandmother / grandma","ref":"mother's or father's mother","note":""},
{"target":"grandfather / grandpa","ref":"mother's or father's father","note":""},
{"target":"aunt","ref":"parent's sister","note":""},
{"target":"uncle","ref":"parent's brother","note":""},
{"target":"cousin","ref":"aunt or uncle's child","note":"pronounced 'KUZ-in'"},
{"target":"husband / wife","ref":"married man / married woman","note":""},
{"target":"child / children","ref":"son or daughter (irregular plural)","note":"'children' is irregular, not 'childs'."}
]}
]}
