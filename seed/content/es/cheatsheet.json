{"categories":[
{"name":"Greetings & Farewells","items":[
{"target":"Hola","ref":"Hello / Hi","note":"the H is silent: OH-la"},
{"target":"Buenos días","ref":"Good morning","note":"used until about midday"},
{"target":"Buenas tardes","ref":"Good afternoon","note":"from noon until dark"},
{"target":"Buenas noches","ref":"Good evening / Good night","note":"both a greeting and a farewell"},
{"target":"¿Cómo estás?","ref":"How are you? (informal)","note":"formal: ¿Cómo está usted?"},
{"target":"Mucho gusto","ref":"Nice to meet you","note":"literally 'much pleasure'"},
{"target":"Adiós","ref":"Goodbye","note":"for a longer parting"},
{"target":"Hasta luego","ref":"See you later","note":"very common casual farewell"},
{"target":"Hasta mañana","ref":"See you tomorrow","note":"mañana = tomorrow / morning"},
{"target":"Nos vemos","ref":"See you around","note":"literally 'we see each other'"},
{"target":"Bienvenido","ref":"Welcome","note":"add -a for a woman: bienvenida"},
{"target":"Que tengas un buen día","ref":"Have a nice day","note":"uses the subjunctive tengas"}
]},
{"name":"Numbers 1–20","items":[
{"target":"uno","ref":"one","note":"becomes 'un' before a masculine noun"},
{"target":"dos","ref":"two","note":"DOHS"},
{"target":"tres","ref":"three","note":"TREHS"},
{"target":"cuatro","ref":"four","note":"KWAH-tro"},
{"target":"cinco","ref":"five","note":"SEEN-ko"},
{"target":"seis","ref":"six","note":"SAYSS"},
{"target":"siete","ref":"seven","note":"SYEH-teh"},
{"target":"ocho","ref":"eight","note":"OH-cho"},
{"target":"nueve","ref":"nine","note":"NWEH-veh"},
{"target":"diez","ref":"ten","note":"DYESS"},
{"target":"once","ref":"eleven","note":"11–15 are single words, not 'diez y...'"},
{"target":"doce","ref":"twelve","note":"DOH-seh"},
{"target":"trece","ref":"thirteen","note":"TREH-seh"},
{"target":"catorce","ref":"fourteen","note":"ka-TOR-seh"},
{"target":"quince","ref":"fifteen","note":"KEEN-seh"},
{"target":"dieciséis","ref":"sixteen","note":"16–19 = diez+six etc., written as one word"},
{"target":"diecisiete","ref":"seventeen","note":"dyeh-see-SYEH-teh"},
{"target":"dieciocho","ref":"eighteen","note":"dyeh-SYOH-cho"},
{"target":"diecinueve","ref":"nineteen","note":"dyeh-see-NWEH-veh"},
{"target":"veinte","ref":"twenty","note":"BAYN-teh"}
]},
{"name":"Days & Months","items":[
{"target":"lunes","ref":"Monday","note":"days are not capitalized in Spanish"},
{"target":"martes","ref":"Tuesday","note":"MAR-tes"},
{"target":"miércoles","ref":"Wednesday","note":"MYEHR-ko-les"},
{"target":"jueves","ref":"Thursday","note":"HWEH-ves"},
{"target":"viernes","ref":"Friday","note":"BYEHR-nes"},
{"target":"sábado","ref":"Saturday","note":"SAH-ba-do"},
{"target":"domingo","ref":"Sunday","note":"the week starts on Monday"},
{"target":"enero","ref":"January","note":"months are lowercase too"},
{"target":"febrero","ref":"February","note":"feh-BREH-ro"},
{"target":"marzo","ref":"March","note":"MAR-so"},
{"target":"abril","ref":"April","note":"ah-BREEL"},
{"target":"mayo","ref":"May","note":"MAH-yo"},
{"target":"julio","ref":"July","note":"HOO-lyo"},
{"target":"agosto","ref":"August","note":"ah-GOS-to"},
{"target":"septiembre","ref":"September","note":"sep-TYEM-breh"},
{"target":"diciembre","ref":"December","note":"dee-SYEM-breh"},
{"target":"hoy","ref":"today","note":"OY"},
{"target":"mañana","ref":"tomorrow","note":"also means 'morning'"},
{"target":"ayer","ref":"yesterday","note":"ah-YEHR"}
]},
{"name":"Essential Verbs (yo / tú / él)","items":[
{"target":"ser: soy, eres, es","ref":"to be (permanent)","note":"identity, origin, time"},
{"target":"estar: estoy, estás, está","ref":"to be (state/location)","note":"feelings and where things are"},
{"target":"tener: tengo, tienes, tiene","ref":"to have","note":"also for age: tengo 20 años"},
{"target":"ir: voy, vas, va","ref":"to go","note":"ir a + place; ir a + infinitive = going to"},
{"target":"hacer: hago, haces, hace","ref":"to do / to make","note":"irregular yo form: hago"},
{"target":"poder: puedo, puedes, puede","ref":"to be able / can","note":"o→ue stem change"},
{"target":"querer: quiero, quieres, quiere","ref":"to want / to love","note":"e→ie stem change"},
{"target":"saber: sé, sabes, sabe","ref":"to know (facts)","note":"yo form is just sé"},
{"target":"venir: vengo, vienes, viene","ref":"to come","note":"irregular yo + e→ie"},
{"target":"decir: digo, dices, dice","ref":"to say / to tell","note":"irregular yo + e→i"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"¿qué?","ref":"what?","note":"question words carry a written accent"},
{"target":"¿quién?","ref":"who?","note":"plural: ¿quiénes?"},
{"target":"¿dónde?","ref":"where?","note":"¿adónde? = to where?"},
{"target":"¿cuándo?","ref":"when?","note":"KWAN-do"},
{"target":"¿cómo?","ref":"how?","note":"also 'what?' when you didn't hear"},
{"target":"¿por qué?","ref":"why?","note":"answer with porque (one word)"},
{"target":"¿cuánto?","ref":"how much?","note":"agrees: ¿cuántos?/¿cuántas?"},
{"target":"¿cuál?","ref":"which?","note":"plural: ¿cuáles?"},
{"target":"y","ref":"and","note":"becomes e before an i/hi sound"},
{"target":"pero","ref":"but","note":"PEH-ro"},
{"target":"porque","ref":"because","note":"one word, no accent (vs. ¿por qué?)"},
{"target":"también","ref":"also / too","note":"opposite: tampoco (neither)"}
]},
{"name":"Survival Phrases","items":[
{"target":"Por favor","ref":"Please","note":"add it to soften any request"},
{"target":"Gracias / De nada","ref":"Thank you / You're welcome","note":"muchas gracias = thanks a lot"},
{"target":"Perdón / Disculpe","ref":"Excuse me / Sorry","note":"disculpe to get attention politely"},
{"target":"No entiendo","ref":"I don't understand","note":"en-TYEN-do"},
{"target":"¿Habla inglés?","ref":"Do you speak English?","note":"formal 'you' form"},
{"target":"¿Puede ayudarme?","ref":"Can you help me?","note":"pronoun me attaches to the infinitive"},
{"target":"¿Dónde está el baño?","ref":"Where is the bathroom?","note":"also el aseo / el servicio in Spain"},
{"target":"¿Cuánto cuesta?","ref":"How much does it cost?","note":"KWAN-to KWES-ta"},
{"target":"Estoy perdido","ref":"I'm lost","note":"a woman says perdida"},
{"target":"Necesito un médico","ref":"I need a doctor","note":"neh-seh-SEE-to"},
{"target":"¡Ayuda! / ¡Socorro!","ref":"Help!","note":"socorro is the stronger emergency cry"},
{"target":"Llame a la policía","ref":"Call the police","note":"double-l sounds like a Y"}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"¿Qué hora es?","ref":"What time is it?","note":"literally 'what hour is it?'"},
{"target":"Es la una","ref":"It's one o'clock","note":"only 1:00 uses 'es la'"},
{"target":"Son las dos","ref":"It's two o'clock","note":"all other hours use 'son las'"},
{"target":"y media","ref":"half past","note":"son las tres y media = 3:30"},
{"target":"y cuarto","ref":"quarter past","note":"las cinco y cuarto = 5:15"},
{"target":"menos cuarto","ref":"quarter to","note":"las seis menos cuarto = 5:45"},
{"target":"de la mañana","ref":"in the morning (a.m.)","note":"used with a specific time"},
{"target":"de la tarde","ref":"in the afternoon (p.m.)","note":"roughly noon–8 p.m."},
{"target":"de la noche","ref":"at night","note":"after dark"},
{"target":"el mediodía","ref":"noon / midday","note":"la medianoche = midnight"},
{"target":"ahora","ref":"now","note":"ahora mismo = right now"},
{"target":"temprano / tarde","ref":"early / late","note":"llegar tarde = to arrive late"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"grande / pequeño","ref":"big / small","note":"grande shortens to gran before a noun"},
{"target":"bueno / malo","ref":"good / bad","note":"drop the -o before a masc. noun: buen día"},
{"target":"nuevo / viejo","ref":"new / old","note":"viejo for things or people"},
{"target":"alto / bajo","ref":"tall / short","note":"also high / low"},
{"target":"caro / barato","ref":"expensive / cheap","note":"ba-RAH-to"},
{"target":"fácil / difícil","ref":"easy / difficult","note":"both invariable for gender"},
{"target":"rápido / lento","ref":"fast / slow","note":"RAH-pee-do"},
{"target":"caliente / frío","ref":"hot / cold","note":"of things; for weather use hace calor/frío"},
{"target":"largo / corto","ref":"long / short","note":"largo is a false friend, not 'large'"},
{"target":"feliz / triste","ref":"happy / sad","note":"feliz plural: felices"},
{"target":"limpio / sucio","ref":"clean / dirty","note":"SOO-syo = dirty"},
{"target":"lleno / vacío","ref":"full / empty","note":"vacío has an accent on the í"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"Una mesa para dos, por favor","ref":"A table for two, please","note":"MEH-sa = table"},
{"target":"La carta, por favor","ref":"The menu, please","note":"el menú often means the fixed set menu"},
{"target":"¿Qué me recomienda?","ref":"What do you recommend?","note":"formal usted form"},
{"target":"Para mí, la paella","ref":"For me, the paella","note":"para mí = for me"},
{"target":"Quisiera un café","ref":"I would like a coffee","note":"quisiera is softer than quiero"},
{"target":"¿Está incluida la propina?","ref":"Is the tip included?","note":"la propina = the tip"},
{"target":"La cuenta, por favor","ref":"The bill, please","note":"KWEN-ta"},
{"target":"Está delicioso","ref":"It's delicious","note":"or ¡Qué rico! = How tasty!"},
{"target":"Soy vegetariano","ref":"I'm vegetarian","note":"a woman says vegetariana"},
{"target":"Sin gluten","ref":"Gluten-free","note":"sin = without"},
{"target":"agua con/sin gas","ref":"sparkling / still water","note":"literally with/without gas"},
{"target":"para llevar","ref":"to go / takeaway","note":"opposite: para tomar aquí"}
]},
{"name":"Shopping & Money","items":[
{"target":"¿Cuánto cuesta?","ref":"How much is it?","note":"plural things: ¿cuánto cuestan?"},
{"target":"Es muy caro","ref":"It's very expensive","note":"opposite: es barato"},
{"target":"¿Tiene una talla más grande?","ref":"Do you have a bigger size?","note":"la talla = clothing size"},
{"target":"¿Puedo probármelo?","ref":"Can I try it on?","note":"probarse = to try on"},
{"target":"Solo estoy mirando","ref":"I'm just looking","note":"polite reply to a shop assistant"},
{"target":"¿Aceptan tarjeta?","ref":"Do you take cards?","note":"la tarjeta = card"},
{"target":"Voy a pagar en efectivo","ref":"I'll pay in cash","note":"el efectivo = cash"},
{"target":"¿Me da un recibo?","ref":"Can I have a receipt?","note":"el recibo = receipt"},
{"target":"Está en oferta","ref":"It's on sale","note":"las rebajas = the sales"},
{"target":"Me lo llevo","ref":"I'll take it","note":"literally 'I take it away'"},
{"target":"el cambio","ref":"the change","note":"also means 'exchange rate'"},
{"target":"¿Dónde está la caja?","ref":"Where is the checkout?","note":"la caja = cash register"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"¿Qué tiempo hace?","ref":"What's the weather like?","note":"weather uses hacer, not ser"},
{"target":"Hace calor","ref":"It's hot","note":"literally 'it makes heat'"},
{"target":"Hace frío","ref":"It's cold","note":"opposite of hace calor"},
{"target":"Hace sol","ref":"It's sunny","note":"el sol = the sun"},
{"target":"Hace viento","ref":"It's windy","note":"el viento = wind"},
{"target":"Está nublado","ref":"It's cloudy","note":"uses estar, not hacer"},
{"target":"Llueve","ref":"It's raining","note":"from llover (o→ue)"},
{"target":"Nieva","ref":"It's snowing","note":"from nevar (e→ie)"},
{"target":"¿Qué tal?","ref":"How's it going?","note":"casual all-purpose opener"},
{"target":"¿De dónde eres?","ref":"Where are you from?","note":"answer: soy de..."},
{"target":"¿A qué te dedicas?","ref":"What do you do (for work)?","note":"literally 'to what do you dedicate yourself?'"},
{"target":"¡Que te vaya bien!","ref":"Take care! / All the best!","note":"warm parting phrase"}
]},
{"name":"Family Members","items":[
{"target":"la madre","ref":"mother","note":"casual: mamá"},
{"target":"el padre","ref":"father","note":"casual: papá; plural los padres = parents"},
{"target":"el hijo / la hija","ref":"son / daughter","note":"los hijos = children"},
{"target":"el hermano / la hermana","ref":"brother / sister","note":"los hermanos = siblings"},
{"target":"el abuelo / la abuela","ref":"grandfather / grandmother","note":"los abuelos = grandparents"},
{"target":"el tío / la tía","ref":"uncle / aunt","note":"in Spain también = 'dude'"},
{"target":"el primo / la prima","ref":"cousin","note":"PREE-mo"},
{"target":"el sobrino / la sobrina","ref":"nephew / niece","note":"so-BREE-no"},
{"target":"el esposo / la esposa","ref":"husband / wife","note":"also el marido / la mujer"},
{"target":"el novio / la novia","ref":"boyfriend / girlfriend","note":"also groom / bride"},
{"target":"el nieto / la nieta","ref":"grandson / granddaughter","note":"NYEH-to"},
{"target":"los suegros","ref":"parents-in-law","note":"la suegra = mother-in-law"}
]}
]}
