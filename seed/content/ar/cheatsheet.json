{"categories":[
{"name":"Greetings & Polite Phrases","items":[
{"target":"السَّلامُ عَلَيْكُم","ref":"Peace be upon you (hello)","note":"as-salāmu ʿalaykum — universal greeting; reply below"},
{"target":"وعَلَيْكُمُ السَّلام","ref":"And upon you peace (reply)","note":"wa-ʿalaykum as-salām — the standard response"},
{"target":"صَباحُ الخَيْر","ref":"Good morning","note":"ṣabāḥ al-khayr; reply ṣabāḥ an-nūr"},
{"target":"مَساءُ الخَيْر","ref":"Good evening","note":"masāʾ al-khayr; reply masāʾ an-nūr"},
{"target":"أَهْلاً وسَهْلاً","ref":"Welcome / hi","note":"ahlan wa-sahlan; casual ahlan alone works"},
{"target":"مَعَ السَّلامة","ref":"Goodbye","note":"maʿa as-salāma — lit. 'with safety'"},
{"target":"شُكْراً","ref":"Thank you","note":"shukran; reply ʿafwan (you're welcome)"},
{"target":"مِنْ فَضْلِك","ref":"Please","note":"min faḍlik (to a man), min faḍliki (to a woman)"},
{"target":"لَوْ سَمَحْت","ref":"Excuse me / please (getting attention)","note":"law samaḥt (m.), law samaḥti (f.)"},
{"target":"عَفْواً","ref":"Sorry / pardon / you're welcome","note":"ʿafwan — versatile apology and reply to thanks"},
{"target":"كَيْفَ حالُك؟","ref":"How are you?","note":"kayfa ḥāluk (m.) / ḥāluki (f.)"},
{"target":"بِخَيْر، الحَمْدُ لله","ref":"Fine, praise be to God","note":"bi-khayr, al-ḥamdu lillāh — the usual reply"}
]},
{"name":"Numbers 1–20","items":[
{"target":"واحِد ١","ref":"one (1)","note":"wāḥid; digits are written left-to-right: ١٢٣"},
{"target":"اثْنان ٢","ref":"two (2)","note":"ithnān"},
{"target":"ثَلاثة ٣","ref":"three (3)","note":"thalātha"},
{"target":"أَرْبَعة ٤","ref":"four (4)","note":"arbaʿa"},
{"target":"خَمْسة ٥","ref":"five (5)","note":"khamsa"},
{"target":"سِتّة ٦","ref":"six (6)","note":"sitta"},
{"target":"سَبْعة ٧","ref":"seven (7)","note":"sabʿa"},
{"target":"ثَمانية ٨","ref":"eight (8)","note":"thamāniya"},
{"target":"تِسْعة ٩","ref":"nine (9)","note":"tisʿa"},
{"target":"عَشَرة ١٠","ref":"ten (10)","note":"ʿashara"},
{"target":"خَمْسة عَشَر ١٥","ref":"fifteen (15)","note":"khamsata ʿashar"},
{"target":"عِشْرون ٢٠","ref":"twenty (20)","note":"ʿishrūn"}
]},
{"name":"Days, Months & Time Expressions","items":[
{"target":"الأَحَد","ref":"Sunday","note":"al-aḥad; the week starts on Sunday"},
{"target":"الاثْنَيْن","ref":"Monday","note":"al-ithnayn"},
{"target":"الثُّلاثاء","ref":"Tuesday","note":"ath-thulāthāʾ"},
{"target":"الأَرْبِعاء","ref":"Wednesday","note":"al-arbiʿāʾ"},
{"target":"الخَميس","ref":"Thursday","note":"al-khamīs"},
{"target":"الجُمْعة","ref":"Friday","note":"al-jumʿa — the day of congregational prayer"},
{"target":"السَّبْت","ref":"Saturday","note":"as-sabt"},
{"target":"اليَوْم","ref":"today","note":"al-yawm"},
{"target":"غَداً","ref":"tomorrow","note":"ghadan"},
{"target":"أَمْسِ","ref":"yesterday","note":"ams"},
{"target":"الأُسْبوع","ref":"week","note":"al-usbūʿ; shahr = month, sana = year"},
{"target":"الآن","ref":"now","note":"al-ān"}
]},
{"name":"Essential Verbs (past / present)","items":[
{"target":"ذَهَبَ / يَذْهَب","ref":"went / goes","note":"dhahaba / yadhhab"},
{"target":"أَكَلَ / يَأْكُل","ref":"ate / eats","note":"akala / yaʾkul"},
{"target":"شَرِبَ / يَشْرَب","ref":"drank / drinks","note":"shariba / yashrab"},
{"target":"قالَ / يَقول","ref":"said / says","note":"qāla / yaqūl — hollow verb"},
{"target":"كَتَبَ / يَكْتُب","ref":"wrote / writes","note":"kataba / yaktub"},
{"target":"عَمِلَ / يَعْمَل","ref":"did, worked / does, works","note":"ʿamila / yaʿmal"},
{"target":"أَرادَ / يُريد","ref":"wanted / wants","note":"arāda / yurīd"},
{"target":"عَرَفَ / يَعْرِف","ref":"knew / knows","note":"ʿarafa / yaʿrif"},
{"target":"جاءَ / يَجيء","ref":"came / comes","note":"jāʾa / yajīʾ"},
{"target":"نامَ / يَنام","ref":"slept / sleeps","note":"nāma / yanām"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"ما / ماذا","ref":"what","note":"mā (before a noun) / mādhā (before a verb)"},
{"target":"مَنْ","ref":"who","note":"man"},
{"target":"أَيْنَ","ref":"where","note":"ayna"},
{"target":"مَتى","ref":"when","note":"matā"},
{"target":"كَيْفَ","ref":"how","note":"kayfa"},
{"target":"لِماذا","ref":"why","note":"limādhā"},
{"target":"كَمْ","ref":"how many / how much","note":"kam; followed by a singular noun"},
{"target":"و","ref":"and","note":"wa- (attached to the next word)"},
{"target":"لكِنْ","ref":"but","note":"lākin"},
{"target":"لأَنَّ","ref":"because","note":"li-anna"},
{"target":"إذا","ref":"if","note":"idhā"},
{"target":"أيْضاً","ref":"also / too","note":"ayḍan"}
]},
{"name":"Survival Phrases","items":[
{"target":"لا أَفْهَم","ref":"I don't understand","note":"lā afham"},
{"target":"هَلْ تَتَكَلَّمُ الإنجليزيّة؟","ref":"Do you speak English?","note":"hal tatakallamu al-injlīziyya?"},
{"target":"تَكَلَّمْ بِبُطْءٍ، مِنْ فَضْلِك","ref":"Speak slowly, please","note":"takallam bi-buṭʾ, min faḍlik"},
{"target":"ما اسْمُك؟","ref":"What is your name?","note":"mā-smuk (m.) / mā-smuki (f.)"},
{"target":"اسْمي...","ref":"My name is...","note":"ismī..."},
{"target":"أَيْنَ الحَمّام؟","ref":"Where is the bathroom?","note":"ayna al-ḥammām?"},
{"target":"كَمِ السّاعة؟","ref":"What time is it?","note":"kam is-sāʿa?"},
{"target":"ساعِدْني، مِنْ فَضْلِك","ref":"Help me, please","note":"sāʿidnī, min faḍlik"},
{"target":"أَنا تائِه","ref":"I am lost","note":"anā tāʾih (m.) / tāʾiha (f.)"},
{"target":"كَمْ هٰذا؟","ref":"How much is this?","note":"kam hādhā?"},
{"target":"لا أُريد، شُكْراً","ref":"I don't want [it], thanks","note":"lā urīd, shukran"},
{"target":"أَيْنَ المَحَطّة؟","ref":"Where is the station?","note":"ayna al-maḥaṭṭa?"}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"السّاعةُ الواحِدة","ref":"one o'clock","note":"as-sāʿa al-wāḥida"},
{"target":"السّاعةُ الثّانية","ref":"two o'clock","note":"as-sāʿa ath-thāniya"},
{"target":"السّاعةُ الثّالثة","ref":"three o'clock","note":"as-sāʿa ath-thālitha"},
{"target":"والنِّصْف","ref":"...and a half (:30)","note":"wa-n-niṣf — 'and the half'"},
{"target":"والرُّبْع","ref":"...and a quarter (:15)","note":"wa-r-rubʿ"},
{"target":"إلّا رُبْعاً","ref":"...quarter to","note":"illā rubʿan — 'minus a quarter'"},
{"target":"والثُّلْث","ref":"...and a third (:20)","note":"wa-th-thulth"},
{"target":"صَباحاً","ref":"in the morning / a.m.","note":"ṣabāḥan"},
{"target":"مَساءً","ref":"in the evening / p.m.","note":"masāʾan"},
{"target":"ظُهْراً","ref":"at noon","note":"ẓuhran"},
{"target":"دَقيقة","ref":"minute","note":"daqīqa; sāʿa = hour"},
{"target":"في تَمامِ السّاعة","ref":"exactly on the hour","note":"fī tamām is-sāʿa"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"كَبير / صَغير","ref":"big / small","note":"kabīr / ṣaghīr"},
{"target":"طَويل / قَصير","ref":"tall, long / short","note":"ṭawīl / qaṣīr"},
{"target":"جَديد / قَديم","ref":"new / old","note":"jadīd / qadīm"},
{"target":"جَميل / قَبيح","ref":"beautiful / ugly","note":"jamīl / qabīḥ"},
{"target":"جَيِّد / سَيِّئ","ref":"good / bad","note":"jayyid / sayyiʾ"},
{"target":"سَهْل / صَعْب","ref":"easy / difficult","note":"sahl / ṣaʿb"},
{"target":"سَريع / بَطيء","ref":"fast / slow","note":"sarīʿ / baṭīʾ"},
{"target":"حارّ / بارِد","ref":"hot / cold","note":"ḥārr / bārid"},
{"target":"غالٍ / رَخيص","ref":"expensive / cheap","note":"ghālin / rakhīṣ"},
{"target":"قَريب / بَعيد","ref":"near / far","note":"qarīb / baʿīd"},
{"target":"كَثير / قَليل","ref":"much / little","note":"kathīr / qalīl"},
{"target":"سَعيد / حَزين","ref":"happy / sad","note":"saʿīd / ḥazīn"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"القائمة، مِنْ فَضْلِك","ref":"The menu, please","note":"al-qāʾima, min faḍlik"},
{"target":"أُريدُ أَنْ أَطْلُب","ref":"I would like to order","note":"urīdu an aṭlub"},
{"target":"ماذا تَنْصَحُني؟","ref":"What do you recommend?","note":"mādhā tanṣaḥunī?"},
{"target":"أَنا نَباتيّ","ref":"I am vegetarian","note":"anā nabātī (m.) / nabātiyya (f.)"},
{"target":"بِدونِ لَحْم","ref":"without meat","note":"bidūn laḥm"},
{"target":"كوبُ ماءٍ، مِنْ فَضْلِك","ref":"A glass of water, please","note":"kūb māʾ, min faḍlik"},
{"target":"شايٌ بِالنَّعْناع","ref":"tea with mint","note":"shāy bi-n-naʿnāʿ — very popular"},
{"target":"لَذيذٌ جِدّاً","ref":"very delicious","note":"ladhīdh jiddan"},
{"target":"الحِساب، مِنْ فَضْلِك","ref":"The bill, please","note":"al-ḥisāb, min faḍlik"},
{"target":"هَلْ يوجَدُ...؟","ref":"Is there...? / Do you have...?","note":"hal yūjadu...?"},
{"target":"أَنا شَبْعان","ref":"I am full","note":"anā shabʿān (m.) / shabʿāna (f.)"},
{"target":"صَحّتَيْن","ref":"Bon appétit / to your health","note":"ṣaḥḥatayn — said before eating"}
]},
{"name":"Shopping & Money","items":[
{"target":"بِكَمْ هٰذا؟","ref":"How much is this?","note":"bi-kam hādhā?"},
{"target":"غالٍ جِدّاً","ref":"Very expensive","note":"ghālin jiddan"},
{"target":"هَلْ عِنْدَكَ أَرْخَص؟","ref":"Do you have something cheaper?","note":"hal ʿindaka arkhaṣ?"},
{"target":"أُريدُ هٰذا","ref":"I want this","note":"urīdu hādhā"},
{"target":"مُمْكِن تَخْفيض؟","ref":"Can you give a discount?","note":"mumkin takhfīḍ? — common in a souk"},
{"target":"سآخُذُه","ref":"I'll take it","note":"sa-ākhudhuh"},
{"target":"أَدْفَعُ بِالبِطاقة","ref":"I'll pay by card","note":"adfaʿu bi-l-biṭāqa"},
{"target":"نَقْداً","ref":"in cash","note":"naqdan"},
{"target":"الفاتورة، مِنْ فَضْلِك","ref":"The receipt, please","note":"al-fātūra, min faḍlik"},
{"target":"البَاقي","ref":"the change","note":"al-bāqī — money returned"},
{"target":"كَمِ الحِساب؟","ref":"What's the total?","note":"kam il-ḥisāb?"},
{"target":"هٰذا كَثير","ref":"That's too much","note":"hādhā kathīr — bargaining line"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"الجَوُّ جَميلٌ اليَوْم","ref":"The weather is nice today","note":"al-jaww jamīl al-yawm"},
{"target":"الجَوُّ حارٌّ","ref":"It's hot","note":"al-jaww ḥārr"},
{"target":"الجَوُّ بارِد","ref":"It's cold","note":"al-jaww bārid"},
{"target":"إنَّها تُمْطِر","ref":"It's raining","note":"innahā tumṭir"},
{"target":"الشَّمْسُ ساطِعة","ref":"The sun is shining","note":"ash-shams sāṭiʿa"},
{"target":"كَمِ الدَّرَجة؟","ref":"What's the temperature?","note":"kam id-daraja?"},
{"target":"مِنْ أَيْنَ أَنْت؟","ref":"Where are you from?","note":"min ayna anta (m.) / anti (f.)?"},
{"target":"أَنا مِنْ...","ref":"I am from...","note":"anā min..."},
{"target":"ماذا تَعْمَل؟","ref":"What do you do (job)?","note":"mādhā taʿmal?"},
{"target":"سُرِرْتُ بِلِقائِك","ref":"Nice to meet you","note":"surirtu bi-liqāʾik"},
{"target":"كَمْ عُمْرُك؟","ref":"How old are you?","note":"kam ʿumruk?"},
{"target":"إِنْ شاءَ الله","ref":"God willing (hopefully)","note":"in shāʾa Allāh — used for future plans"}
]},
{"name":"Family Members","items":[
{"target":"أَب","ref":"father","note":"ab; abī = my father"},
{"target":"أُمّ","ref":"mother","note":"umm; ummī = my mother"},
{"target":"أَخ","ref":"brother","note":"akh; plural ikhwa"},
{"target":"أُخْت","ref":"sister","note":"ukht; plural akhawāt"},
{"target":"جَدّ","ref":"grandfather","note":"jadd"},
{"target":"جَدّة","ref":"grandmother","note":"jadda"},
{"target":"اِبْن","ref":"son","note":"ibn; plural abnāʾ"},
{"target":"بِنْت","ref":"daughter / girl","note":"bint; plural banāt"},
{"target":"زَوْج","ref":"husband","note":"zawj"},
{"target":"زَوْجة","ref":"wife","note":"zawja"},
{"target":"عَمّ / خال","ref":"paternal uncle / maternal uncle","note":"ʿamm (father's side) / khāl (mother's side)"},
{"target":"عائِلة","ref":"family","note":"ʿāʾila; also usra"}
]}
]}
