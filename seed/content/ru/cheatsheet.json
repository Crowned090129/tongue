{"categories":[
{"name":"Greetings & Polite Phrases","items":[
{"target":"Здравствуйте","ref":"Hello (formal)","note":"ZDRA-stvuy-tye — the 'в' is usually silent; the all-purpose polite hello"},
{"target":"Привет","ref":"Hi (informal)","note":"pree-VYET — for friends and peers only"},
{"target":"Доброе утро","ref":"Good morning","note":"DOB-ra-ye OO-tra — until about noon"},
{"target":"Добрый день","ref":"Good afternoon / day","note":"DOB-ryy dyen — the safe daytime greeting"},
{"target":"Добрый вечер","ref":"Good evening","note":"DOB-ryy VYE-cher — from early evening"},
{"target":"До свидания","ref":"Goodbye","note":"da svee-DA-nya — literally 'until the next meeting'"},
{"target":"Пока","ref":"Bye","note":"pa-KA — casual, like 'see ya'"},
{"target":"Спасибо","ref":"Thank you","note":"spa-SEE-ba — add большое for 'thank you very much'"},
{"target":"Пожалуйста","ref":"Please / You're welcome","note":"pa-ZHA-lus-ta — serves as both 'please' and 'you're welcome'"},
{"target":"Извините","ref":"Excuse me / Sorry","note":"eez-vee-NEE-tye — to get attention or apologize (formal)"},
{"target":"Как дела?","ref":"How are you?","note":"kak dye-LA — informal; reply Хорошо (fine)"},
{"target":"Очень приятно","ref":"Nice to meet you","note":"O-chen pree-YAT-na — literally 'very pleasant'"}
]},
{"name":"Numbers 1–20, 100 & 1000","items":[
{"target":"один / одна / одно","ref":"one","note":"a-DEEN — changes for gender (m./f./n.)"},
{"target":"два / две","ref":"two","note":"dva (m./n.), dvye (f.)"},
{"target":"три","ref":"three","note":"tree"},
{"target":"четыре","ref":"four","note":"che-TY-rye — 2,3,4 take the genitive singular noun"},
{"target":"пять","ref":"five","note":"pyat — 5+ takes the genitive plural noun"},
{"target":"шесть","ref":"six","note":"shest"},
{"target":"семь","ref":"seven","note":"syem"},
{"target":"восемь","ref":"eight","note":"VO-syem"},
{"target":"девять","ref":"nine","note":"DYE-vyat"},
{"target":"десять","ref":"ten","note":"DYE-syat"},
{"target":"одиннадцать","ref":"eleven","note":"a-DEE-na-tsat — 11–19 end in -надцать"},
{"target":"двадцать","ref":"twenty","note":"DVA-tsat"},
{"target":"сто","ref":"one hundred","note":"sto"},
{"target":"тысяча","ref":"one thousand","note":"TY-sya-cha"}
]},
{"name":"Days, Months & Time Expressions","items":[
{"target":"понедельник","ref":"Monday","note":"pa-nye-DYEL-neek — literally 'after Sunday'"},
{"target":"вторник","ref":"Tuesday","note":"FTOR-neek"},
{"target":"среда","ref":"Wednesday","note":"srye-DA — 'the middle'"},
{"target":"четверг","ref":"Thursday","note":"chet-VYERK"},
{"target":"пятница","ref":"Friday","note":"PYAT-nee-tsa"},
{"target":"суббота","ref":"Saturday","note":"soo-BO-ta"},
{"target":"воскресенье","ref":"Sunday","note":"vas-krye-SYEN-ye"},
{"target":"январь","ref":"January","note":"yan-VAR — months are masculine"},
{"target":"сегодня","ref":"today","note":"see-VOD-nya — 'г' sounds like 'v' here"},
{"target":"завтра","ref":"tomorrow","note":"ZAF-tra"},
{"target":"вчера","ref":"yesterday","note":"fche-RA"},
{"target":"неделя","ref":"week","note":"nye-DYE-lya"},
{"target":"месяц","ref":"month","note":"MYE-syats"},
{"target":"год","ref":"year","note":"got"},
{"target":"утром","ref":"in the morning","note":"OO-tram — instrumental case for time of day"},
{"target":"вечером","ref":"in the evening","note":"VYE-che-ram"},
{"target":"сейчас","ref":"now","note":"see-CHAS"},
{"target":"потом","ref":"later / then","note":"pa-TOM"},
{"target":"всегда","ref":"always","note":"fsyeg-DA"}
]},
{"name":"Essential Verbs (я / ты / он form)","items":[
{"target":"быть — есть","ref":"to be — is","note":"byt — the present 'есть' is normally dropped; used in past был/была"},
{"target":"иметь — я имею","ref":"to have — I have","note":"ee-MYET — but 'у меня есть' is far more common for 'I have'"},
{"target":"делать — я делаю, ты делаешь, он делает","ref":"to do/make","note":"DYE-lat — 1st conjugation"},
{"target":"идти — я иду, ты идёшь, он идёт","ref":"to go (on foot)","note":"eet-TEE — one-way motion now"},
{"target":"мочь — я могу, ты можешь, он может","ref":"can / be able","note":"moch — note stem change г→ж"},
{"target":"хотеть — я хочу, ты хочешь, он хочет","ref":"to want","note":"kha-TYET — irregular, mixes both conjugations"},
{"target":"знать — я знаю, ты знаешь, он знает","ref":"to know","note":"znat — 1st conjugation, regular"},
{"target":"говорить — я говорю, ты говоришь, он говорит","ref":"to speak/say","note":"ga-va-REET — 2nd conjugation"},
{"target":"думать — я думаю, ты думаешь, он думает","ref":"to think","note":"DOO-mat — думать о + prepositional"},
{"target":"любить — я люблю, ты любишь, он любит","ref":"to love/like","note":"lyu-BEET — note the extra 'л' in я люблю"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"кто","ref":"who","note":"kto"},
{"target":"что","ref":"what","note":"shto — the 'ч' is pronounced 'sh' here"},
{"target":"где","ref":"where","note":"gdye — location"},
{"target":"куда","ref":"where to","note":"koo-DA — direction"},
{"target":"когда","ref":"when","note":"kag-DA"},
{"target":"почему","ref":"why","note":"pa-che-MOO"},
{"target":"как","ref":"how","note":"kak"},
{"target":"сколько","ref":"how much/many","note":"SKOL-ka — takes genitive"},
{"target":"который","ref":"which / that (relative)","note":"ka-TO-ryy — declines like an adjective"},
{"target":"и","ref":"and","note":"ee"},
{"target":"но","ref":"but","note":"no"},
{"target":"потому что","ref":"because","note":"pa-ta-MOO shta"}
]},
{"name":"Survival Phrases","items":[
{"target":"Сколько это стоит?","ref":"How much does this cost?","note":"SKOL-ka E-ta STO-eet — the essential shopping question"},
{"target":"Где туалет?","ref":"Where is the toilet?","note":"gdye too-a-LYET"},
{"target":"Я не понимаю.","ref":"I don't understand.","note":"ya nye pa-nee-MA-yu"},
{"target":"Вы говорите по-английски?","ref":"Do you speak English?","note":"vy ga-va-REE-tye pa-an-GLEE-skee"},
{"target":"Помогите!","ref":"Help!","note":"pa-ma-GEE-tye"},
{"target":"Мне нужен врач.","ref":"I need a doctor.","note":"mnye NOO-zhen vrach"},
{"target":"Как пройти к...?","ref":"How do I get to...?","note":"kak prai-TEE k — for directions on foot"},
{"target":"Я потерялся.","ref":"I am lost.","note":"ya pa-tye-RYAL-sya — a woman says потерялась"},
{"target":"Повторите, пожалуйста.","ref":"Please repeat.","note":"paf-ta-REE-tye pa-ZHA-lus-ta"},
{"target":"Где ближайшая станция метро?","ref":"Where is the nearest metro station?","note":"gdye blee-ZHAY-sha-ya STAN-tsi-ya mye-TRO"},
{"target":"Вызовите полицию.","ref":"Call the police.","note":"VY-za-vee-tye pa-LEE-tsi-yu"},
{"target":"Мне это не нужно.","ref":"I don't need this.","note":"mnye E-ta nye NOO-zhna"},
{"target":"Один билет, пожалуйста.","ref":"One ticket, please.","note":"a-DEEN bee-LYET"},
{"target":"Где выход?","ref":"Where is the exit?","note":"gdye VY-khat"},
{"target":"Всё в порядке.","ref":"Everything is fine.","note":"fsyo f pa-RYAT-kye"}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"Который час?","ref":"What time is it?","note":"ka-TO-ryy chas"},
{"target":"Сейчас два часа.","ref":"It's two o'clock.","note":"2,3,4 → часа; 1 → час; 5+ → часов"},
{"target":"пять часов","ref":"five o'clock","note":"pyat cha-SOF"},
{"target":"половина третьего","ref":"half past two","note":"pa-la-VEE-na — literally 'half of the third [hour]'"},
{"target":"четверть пятого","ref":"quarter past four","note":"CHET-vyert PYA-ta-va — 'quarter of the fifth'"},
{"target":"без четверти шесть","ref":"quarter to six","note":"byes CHET-vyer-tee — 'without a quarter to six'"},
{"target":"минута","ref":"minute","note":"mee-NOO-ta"},
{"target":"час","ref":"hour","note":"chas — also means 'o'clock'"},
{"target":"полдень","ref":"noon","note":"POL-dyen"},
{"target":"полночь","ref":"midnight","note":"POL-nach"},
{"target":"в три часа","ref":"at three o'clock","note":"f tree cha-SA — 'at' a time uses в + accusative"},
{"target":"через час","ref":"in an hour","note":"CHE-rez chas — 'after/in' a period"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"большой ↔ маленький","ref":"big ↔ small","note":"bal-SHOY / MA-len-kiy"},
{"target":"хороший ↔ плохой","ref":"good ↔ bad","note":"kha-RO-shiy / pla-KHOY"},
{"target":"новый ↔ старый","ref":"new ↔ old","note":"NO-vyy / STA-ryy"},
{"target":"горячий ↔ холодный","ref":"hot ↔ cold","note":"ga-RYA-chiy / kha-LOD-nyy"},
{"target":"быстрый ↔ медленный","ref":"fast ↔ slow","note":"BY-stryy / MYED-len-nyy"},
{"target":"дорогой ↔ дешёвый","ref":"expensive ↔ cheap","note":"da-ra-GOY / dye-SHO-vyy"},
{"target":"высокий ↔ низкий","ref":"tall/high ↔ low","note":"vy-SO-kiy / NEEZ-kiy"},
{"target":"длинный ↔ короткий","ref":"long ↔ short","note":"DLEE-nyy / ka-ROT-kiy"},
{"target":"красивый ↔ некрасивый","ref":"beautiful ↔ ugly","note":"kra-SEE-vyy"},
{"target":"лёгкий ↔ тяжёлый","ref":"light/easy ↔ heavy/hard","note":"LYOKH-kiy / tya-ZHO-lyy"},
{"target":"чистый ↔ грязный","ref":"clean ↔ dirty","note":"CHEE-styy / GRYAZ-nyy"},
{"target":"полный ↔ пустой","ref":"full ↔ empty","note":"POL-nyy / poo-STOY"},
{"target":"тёплый ↔ прохладный","ref":"warm ↔ cool","note":"TYO-plyy / pra-KHLAD-nyy"},
{"target":"весёлый ↔ грустный","ref":"cheerful ↔ sad","note":"vye-SYO-lyy / GROO-snyy"},
{"target":"тихий ↔ громкий","ref":"quiet ↔ loud","note":"TEE-khiy / GROM-kiy"},
{"target":"близкий ↔ далёкий","ref":"near ↔ far","note":"BLEEZ-kiy / da-LYO-kiy"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"Меню, пожалуйста.","ref":"The menu, please.","note":"mye-NYU pa-ZHA-lus-ta"},
{"target":"Я хочу заказать...","ref":"I would like to order...","note":"ya kha-CHOO za-ka-ZAT"},
{"target":"Что вы посоветуете?","ref":"What do you recommend?","note":"shto vy pa-sa-VYE-tu-ye-tye"},
{"target":"Счёт, пожалуйста.","ref":"The bill, please.","note":"shchot pa-ZHA-lus-ta"},
{"target":"Это очень вкусно.","ref":"This is very tasty.","note":"E-ta O-chen VKOO-sna"},
{"target":"чай с лимоном","ref":"tea with lemon","note":"chay s lee-MO-nam"},
{"target":"чёрный кофе","ref":"black coffee","note":"CHOR-nyy KO-fye"},
{"target":"вода без газа","ref":"still water","note":"va-DA byes GA-za — 'с газом' = sparkling"},
{"target":"Я вегетарианец.","ref":"I am a vegetarian.","note":"ya vye-gye-ta-ree-A-nyets — woman: вегетарианка"},
{"target":"без сахара","ref":"without sugar","note":"byes SA-kha-ra"},
{"target":"Приятного аппетита!","ref":"Enjoy your meal!","note":"pree-YAT-na-va a-pye-TEE-ta"},
{"target":"завтрак / обед / ужин","ref":"breakfast / lunch / dinner","note":"ZAF-trak / a-BYET / OO-zhin"},
{"target":"Можно счёт?","ref":"Can I have the bill?","note":"MOZH-na shchot"},
{"target":"Я буду борщ.","ref":"I'll have borscht.","note":"ya BOO-du borshch — the classic beet soup"},
{"target":"Дайте, пожалуйста, воды.","ref":"Please give me some water.","note":"DAY-tye — воды is genitive ('some')"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"Какая сегодня погода?","ref":"What's the weather today?","note":"ka-KA-ya see-VOD-nya pa-GO-da"},
{"target":"Сегодня тепло.","ref":"It's warm today.","note":"see-VOD-nya tye-PLO"},
{"target":"Сегодня холодно.","ref":"It's cold today.","note":"KHO-lad-na"},
{"target":"Идёт дождь.","ref":"It's raining.","note":"ee-DYOT dozhd — literally 'rain is going'"},
{"target":"Идёт снег.","ref":"It's snowing.","note":"ee-DYOT snyek"},
{"target":"Светит солнце.","ref":"The sun is shining.","note":"SVYE-teet SON-tse"},
{"target":"Дует ветер.","ref":"The wind is blowing.","note":"DOO-yet VYE-tyer"},
{"target":"Как поживаете?","ref":"How are you doing?","note":"kak pa-zhi-VA-ye-tye — polite small talk"},
{"target":"Что нового?","ref":"What's new?","note":"shto NO-va-va"},
{"target":"Хорошей погоды!","ref":"Have good weather!","note":"kha-RO-shey pa-GO-dy"},
{"target":"жарко","ref":"[it's] hot","note":"ZHAR-ka"},
{"target":"облачно","ref":"cloudy","note":"OB-lach-na"},
{"target":"мороз","ref":"frost / hard freeze","note":"ma-ROS — typical of a Russian winter"},
{"target":"Всё хорошо, спасибо.","ref":"All is well, thanks.","note":"fsyo kha-ra-SHO spa-SEE-ba"}
]},
{"name":"Family Members","items":[
{"target":"мама","ref":"mom","note":"MA-ma — affectionate; formal is мать"},
{"target":"папа","ref":"dad","note":"PA-pa — formal is отец"},
{"target":"брат","ref":"brother","note":"brat — plural братья"},
{"target":"сестра","ref":"sister","note":"sye-STRA — plural сёстры"},
{"target":"бабушка","ref":"grandmother","note":"BA-bush-ka"},
{"target":"дедушка","ref":"grandfather","note":"DYE-dush-ka"},
{"target":"сын","ref":"son","note":"syn — plural сыновья"},
{"target":"дочь","ref":"daughter","note":"doch — feminine, ends in soft sign"},
{"target":"муж","ref":"husband","note":"moozh"},
{"target":"жена","ref":"wife","note":"zhe-NA"},
{"target":"дядя","ref":"uncle","note":"DYA-dya — masculine despite -я ending"},
{"target":"тётя","ref":"aunt","note":"TYO-tya"},
{"target":"родители","ref":"parents","note":"ra-DEE-tye-lee"},
{"target":"ребёнок","ref":"child","note":"rye-BYO-nak — plural is irregular: дети"}
]},
{"name":"Polite Requests & Etiquette","items":[
{"target":"Можно...?","ref":"May I...?","note":"MOZH-na — the go-to word for asking permission"},
{"target":"Не могли бы вы...?","ref":"Could you...?","note":"nye ma-GLEE by vy — very polite request"},
{"target":"Будьте добры","ref":"Would you be so kind","note":"BOOT-tye da-BRY — softens a request"},
{"target":"Извините за беспокойство","ref":"Sorry to bother you","note":"eez-vee-NEE-tye za bye-spa-KOY-stva"},
{"target":"Ничего страшного","ref":"No problem / It's okay","note":"nee-che-VO STRASH-na-va — reassuring reply"},
{"target":"На здоровье!","ref":"You're welcome / To your health!","note":"na zda-RO-vye — after being thanked for food"},
{"target":"Прошу прощения","ref":"I beg your pardon","note":"pra-SHOO pra-SHCHE-nee-ya — formal apology"},
{"target":"С удовольствием","ref":"With pleasure","note":"s oo-da-VOL-stvee-yem — accepting an offer"},
{"target":"Разрешите пройти","ref":"Allow me to pass","note":"raz-rye-SHEE-tye prai-TEE — in a crowd"},
{"target":"Приятного дня!","ref":"Have a nice day!","note":"pree-YAT-na-va dnya"},
{"target":"Не за что","ref":"Don't mention it","note":"NYE za shta — casual 'you're welcome'"},
{"target":"Добро пожаловать!","ref":"Welcome!","note":"da-BRO pa-ZHA-la-vat"}
]}
]}
