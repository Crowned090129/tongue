{"categories":[
{"name":"Greetings & Farewells","items":[
{"target":"Olá / Oi","ref":"Hello / Hi","note":"Oi is the most common casual greeting in Brazil"},
{"target":"Bom dia","ref":"Good morning","note":"used until around noon"},
{"target":"Boa tarde","ref":"Good afternoon","note":"from noon until sunset"},
{"target":"Boa noite","ref":"Good evening / Good night","note":"both a greeting and a farewell at night"},
{"target":"Tudo bem?","ref":"How are you? / All good?","note":"literally 'all well?'; reply Tudo bem or Tudo"},
{"target":"Como vai?","ref":"How's it going?","note":"slightly more formal than Tudo bem"},
{"target":"Prazer","ref":"Nice to meet you","note":"short for muito prazer, 'much pleasure'"},
{"target":"Tchau","ref":"Bye","note":"the everyday goodbye, from Italian ciao"},
{"target":"Até logo","ref":"See you soon","note":"literally 'until soon'"},
{"target":"Até amanhã","ref":"See you tomorrow","note":"até + a time means 'see you at'"},
{"target":"Falou!","ref":"Later! / Catch you!","note":"very casual Brazilian sign-off among friends"},
{"target":"Se cuida","ref":"Take care","note":"warm farewell; literally 'take care of yourself'"}
]},
{"name":"Numbers 1–20","items":[
{"target":"um / uma","ref":"one","note":"has gender: um livro, uma casa"},
{"target":"dois / duas","ref":"two","note":"also gendered: dois homens, duas mulheres"},
{"target":"três","ref":"three","note":"circumflex on the ê"},
{"target":"quatro","ref":"four","note":"stress on QUA-tro"},
{"target":"cinco","ref":"five","note":"SEEN-koo"},
{"target":"seis","ref":"six","note":"in phone/address dictation Brazilians say meia (half a dozen)"},
{"target":"sete","ref":"seven","note":"SEH-chee in Brazil"},
{"target":"oito","ref":"eight","note":"OY-too"},
{"target":"nove","ref":"nine","note":"NOH-vee"},
{"target":"dez","ref":"ten","note":"deys"},
{"target":"onze / doze / treze","ref":"eleven / twelve / thirteen","note":"11, 12, 13"},
{"target":"quinze / dezesseis / vinte","ref":"fifteen / sixteen / twenty","note":"14 is catorze; teens from 16 use deze-"}
]},
{"name":"Days & Months","items":[
{"target":"segunda-feira","ref":"Monday","note":"weekdays are numbered; often shortened to segunda"},
{"target":"terça-feira","ref":"Tuesday","note":"note the ç"},
{"target":"quarta-feira","ref":"Wednesday","note":"literally 'fourth day'"},
{"target":"quinta-feira","ref":"Thursday","note":"shortened to quinta"},
{"target":"sexta-feira","ref":"Friday","note":"shortened to sexta"},
{"target":"sábado / domingo","ref":"Saturday / Sunday","note":"the only two not called -feira"},
{"target":"janeiro / fevereiro / março","ref":"January / February / March","note":"months are lowercase in Portuguese"},
{"target":"abril / maio / junho","ref":"April / May / June","note":"junho has a nasal -nh-"},
{"target":"julho / agosto / setembro","ref":"July / August / September","note":"lh in julho sounds like 'ly'"},
{"target":"outubro / novembro / dezembro","ref":"October / November / December","note":"end of the year"},
{"target":"hoje / ontem / amanhã","ref":"today / yesterday / tomorrow","note":"amanhã has a nasal ã"},
{"target":"o mês / a semana / o ano","ref":"month / week / year","note":"mês takes a circumflex"}
]},
{"name":"Essential Verbs (eu/você/ele forms)","items":[
{"target":"ser: sou / é / é","ref":"to be (identity)","note":"permanent traits; você and ele share é"},
{"target":"estar: estou / está / está","ref":"to be (state/location)","note":"temporary; spoken as tô / tá"},
{"target":"ter: tenho / tem / tem","ref":"to have","note":"also 'there is': tem pão? = is there bread?"},
{"target":"ir: vou / vai / vai","ref":"to go","note":"vou + infinitive makes the near future"},
{"target":"fazer: faço / faz / faz","ref":"to do / to make","note":"faz also expresses weather and time ago"},
{"target":"poder: posso / pode / pode","ref":"can / may","note":"Posso? = May I?"},
{"target":"querer: quero / quer / quer","ref":"to want","note":"Quer + infinitive to offer politely"},
{"target":"saber: sei / sabe / sabe","ref":"to know (facts)","note":"vs conhecer for people/places"},
{"target":"vir: venho / vem / vem","ref":"to come","note":"do not confuse with ver (to see)"},
{"target":"dizer: digo / diz / diz","ref":"to say / to tell","note":"diz que = 'they say that'"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"o que / que","ref":"what","note":"O que é isso? What is this?"},
{"target":"quem","ref":"who","note":"Quem é? Who is it?"},
{"target":"onde / aonde","ref":"where / where to","note":"aonde with verbs of motion"},
{"target":"quando","ref":"when","note":"Quando você chega? When do you arrive?"},
{"target":"por que / por quê","ref":"why","note":"por quê with an accent at the end of a sentence"},
{"target":"como","ref":"how","note":"also 'like/as': como você"},
{"target":"quanto / quantos","ref":"how much / how many","note":"agrees: quantas pessoas?"},
{"target":"qual / quais","ref":"which","note":"Qual é o seu? Which is yours?"},
{"target":"e / mas / ou","ref":"and / but / or","note":"basic connectors"},
{"target":"porque","ref":"because","note":"one word, answering por que"},
{"target":"então","ref":"so / then","note":"very common filler and connector"},
{"target":"também / por isso","ref":"also / therefore","note":"também goes after the verb"}
]},
{"name":"Survival Phrases","items":[
{"target":"Por favor","ref":"Please","note":"add it to soften any request"},
{"target":"Obrigado / Obrigada","ref":"Thank you","note":"men say obrigado, women obrigada"},
{"target":"De nada","ref":"You're welcome","note":"literally 'of nothing'"},
{"target":"Desculpa / Com licença","ref":"Sorry / Excuse me","note":"com licença to pass or interrupt"},
{"target":"Você fala inglês?","ref":"Do you speak English?","note":"handy when stuck"},
{"target":"Não entendi","ref":"I didn't understand","note":"or Como? to ask for a repeat"},
{"target":"Pode repetir, por favor?","ref":"Can you repeat, please?","note":"or Mais devagar = slower"},
{"target":"Onde fica o banheiro?","ref":"Where is the bathroom?","note":"banheiro in Brazil, casa de banho in Portugal"},
{"target":"Quanto custa?","ref":"How much is it?","note":"or Quanto é?"},
{"target":"Eu preciso de ajuda","ref":"I need help","note":"precisar de + noun"},
{"target":"Socorro!","ref":"Help! (emergency)","note":"shout in real danger"},
{"target":"Estou perdido / perdida","ref":"I'm lost","note":"agrees with your gender"}
]},
{"name":"Time & Telling the Clock","items":[
{"target":"Que horas são?","ref":"What time is it?","note":"literally 'what hours are'"},
{"target":"É uma hora","ref":"It's one o'clock","note":"singular É only for 1:00, noon, midnight"},
{"target":"São duas horas","ref":"It's two o'clock","note":"plural São for 2:00 and later"},
{"target":"São três e meia","ref":"It's half past three","note":"e meia = and a half"},
{"target":"São quatro e quinze","ref":"It's a quarter past four","note":"or e um quarto"},
{"target":"São cinco menos dez","ref":"It's ten to five","note":"or faltam dez para as cinco"},
{"target":"meio-dia / meia-noite","ref":"noon / midnight","note":"use singular É: É meio-dia"},
{"target":"da manhã / da tarde / da noite","ref":"in the morning / afternoon / evening","note":"clarifies AM/PM"},
{"target":"agora / já","ref":"now / already, right now","note":"já can mean 'immediately'"},
{"target":"cedo / tarde","ref":"early / late","note":"chegou tarde = arrived late"},
{"target":"em ponto","ref":"on the dot / sharp","note":"às três em ponto"},
{"target":"daqui a pouco","ref":"in a little while","note":"very common for 'soon'"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"grande / pequeno","ref":"big / small","note":"grande is invariable in gender"},
{"target":"bom / ruim","ref":"good / bad","note":"Brazil prefers ruim over mau for 'bad'"},
{"target":"novo / velho","ref":"new / old","note":"velho for people can be rude; use idoso"},
{"target":"alto / baixo","ref":"tall/high / short/low","note":"also loud/quiet for volume"},
{"target":"caro / barato","ref":"expensive / cheap","note":"É muito caro = it's very expensive"},
{"target":"quente / frio","ref":"hot / cold","note":"Está frio hoje = it's cold today"},
{"target":"fácil / difícil","ref":"easy / difficult","note":"both stress the í"},
{"target":"bonito / feio","ref":"pretty / ugly","note":"lindo is a stronger 'beautiful'"},
{"target":"rápido / lento (devagar)","ref":"fast / slow","note":"devagar is used adverbially: fale devagar"},
{"target":"perto / longe","ref":"near / far","note":"perto de, longe de"},
{"target":"cheio / vazio","ref":"full / empty","note":"o copo está cheio"},
{"target":"feliz / triste","ref":"happy / sad","note":"feliz is invariable in gender"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"Uma mesa para dois, por favor","ref":"A table for two, please","note":"para + number of people"},
{"target":"O cardápio, por favor","ref":"The menu, please","note":"cardápio in Brazil, ementa in Portugal"},
{"target":"Eu queria...","ref":"I would like...","note":"softer than Eu quero for ordering"},
{"target":"Qual é o prato do dia?","ref":"What's today's special?","note":"prato do dia = dish of the day"},
{"target":"Sem cebola, por favor","ref":"Without onion, please","note":"sem = without; com = with"},
{"target":"Para mim, um suco de laranja","ref":"For me, an orange juice","note":"suco (Brazil) vs sumo (Portugal)"},
{"target":"Está uma delícia!","ref":"It's delicious!","note":"literally 'it's a delight'"},
{"target":"A conta, por favor","ref":"The bill, please","note":"universal end-of-meal phrase"},
{"target":"Aceita cartão?","ref":"Do you take card?","note":"cartão de crédito/débito"},
{"target":"O serviço está incluído?","ref":"Is service included?","note":"tip is usually 10% (os dez por cento)"},
{"target":"Estou com fome / sede","ref":"I'm hungry / thirsty","note":"estar com + noun for states"},
{"target":"Vou querer a sobremesa","ref":"I'll have the dessert","note":"vou querer = 'I'll have' when ordering"}
]},
{"name":"Shopping & Money","items":[
{"target":"Quanto custa isto?","ref":"How much does this cost?","note":"or Quanto é?"},
{"target":"Está em promoção?","ref":"Is it on sale?","note":"promoção = sale/discount"},
{"target":"Tem desconto?","ref":"Is there a discount?","note":"polite bargaining opener"},
{"target":"Que tamanho você tem?","ref":"What size do you have?","note":"tamanho P/M/G = S/M/L"},
{"target":"Posso experimentar?","ref":"Can I try it on?","note":"experimentar = to try on"},
{"target":"É muito caro","ref":"It's very expensive","note":"gentle way to negotiate"},
{"target":"Vou levar","ref":"I'll take it","note":"levar = to take/buy it"},
{"target":"Só estou olhando","ref":"I'm just looking","note":"polite reply to a salesperson"},
{"target":"Aceita dinheiro ou cartão?","ref":"Cash or card?","note":"dinheiro = cash"},
{"target":"O real / os reais","ref":"the real / reais","note":"Brazil's currency; symbol R$"},
{"target":"o troco","ref":"the change","note":"Fica com o troco = keep the change"},
{"target":"a nota fiscal","ref":"the receipt","note":"ask for it to prove purchase"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"Como está o tempo?","ref":"What's the weather like?","note":"tempo = weather and time"},
{"target":"Está fazendo calor","ref":"It's hot out","note":"fazer for weather: faz calor"},
{"target":"Está frio hoje","ref":"It's cold today","note":"estar frio for the ambient temperature"},
{"target":"Está chovendo","ref":"It's raining","note":"a chuva = the rain"},
{"target":"Está ensolarado","ref":"It's sunny","note":"o sol = the sun"},
{"target":"Que calor!","ref":"So hot!","note":"common exclamation in Brazil"},
{"target":"Tudo tranquilo?","ref":"Everything chill?","note":"very Brazilian casual opener"},
{"target":"E aí, beleza?","ref":"Hey, all good?","note":"beleza literally 'beauty' = 'cool'"},
{"target":"Que bom!","ref":"That's great!","note":"warm reaction to good news"},
{"target":"Nossa!","ref":"Wow! / Gosh!","note":"short for Nossa Senhora; all-purpose surprise"},
{"target":"Pois é","ref":"Yeah, exactly / that's how it is","note":"agreement filler"},
{"target":"Vamos marcar algo","ref":"Let's make plans","note":"marcar = to schedule/arrange"}
]},
{"name":"Family Members","items":[
{"target":"a mãe / o pai","ref":"mother / father","note":"os pais = parents (masculine plural covers both)"},
{"target":"o filho / a filha","ref":"son / daughter","note":"os filhos = children"},
{"target":"o irmão / a irmã","ref":"brother / sister","note":"irmão has a nasal -ão"},
{"target":"o avô / a avó","ref":"grandfather / grandmother","note":"avô (oh) vs avó (aw) differ only in the accent and sound"},
{"target":"o tio / a tia","ref":"uncle / aunt","note":"also a friendly way to address older people"},
{"target":"o primo / a prima","ref":"cousin","note":"gender matches the person"},
{"target":"o marido / a esposa (a mulher)","ref":"husband / wife","note":"mulher also just means 'woman'"},
{"target":"o namorado / a namorada","ref":"boyfriend / girlfriend","note":"namorar = to date"},
{"target":"o neto / a neta","ref":"grandson / granddaughter","note":"os netos = grandchildren"},
{"target":"o sogro / a sogra","ref":"father-in-law / mother-in-law","note":"in-laws"},
{"target":"o sobrinho / a sobrinha","ref":"nephew / niece","note":"related to sobre 'over'"},
{"target":"o cunhado / a cunhada","ref":"brother-in-law / sister-in-law","note":"sibling's spouse"}
]}
]}
