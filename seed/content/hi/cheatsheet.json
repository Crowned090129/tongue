{"categories":[
{"name":"Greetings & Farewells (अभिवादन और विदाई)","items":[
{"target":"नमस्ते","ref":"Hello / Goodbye","note":"namaste — universal, works any time of day"},
{"target":"नमस्कार","ref":"Greetings (respectful)","note":"namaskār — slightly more formal than नमस्ते"},
{"target":"सुप्रभात","ref":"Good morning","note":"suprabhāt — literary; most say नमस्ते"},
{"target":"शुभ रात्रि","ref":"Good night","note":"śubh rātri"},
{"target":"आप कैसे हैं?","ref":"How are you? (formal)","note":"āp kaise hain? — कैसी हैं for a woman"},
{"target":"मैं ठीक हूँ","ref":"I am fine","note":"main ṭhīk hūn"},
{"target":"आपका नाम क्या है?","ref":"What is your name?","note":"āpkā nām kyā hai?"},
{"target":"आपसे मिलकर खुशी हुई","ref":"Nice to meet you","note":"āpse milkar khuśī huī"},
{"target":"फिर मिलेंगे","ref":"See you again","note":"phir milenge"},
{"target":"अलविदा","ref":"Goodbye (farewell)","note":"alvidā — for a longer parting"},
{"target":"धन्यवाद","ref":"Thank you","note":"dhanyavād — शुक्रिया (śukriyā) is common too"},
{"target":"कोई बात नहीं","ref":"You're welcome / No problem","note":"koī bāt nahīn"}
]},
{"name":"Numbers (गिनती)","items":[
{"target":"एक (१)","ref":"one","note":"ek"},
{"target":"दो (२)","ref":"two","note":"do"},
{"target":"तीन (३)","ref":"three","note":"tīn"},
{"target":"चार (४)","ref":"four","note":"cār"},
{"target":"पाँच (५)","ref":"five","note":"pānc"},
{"target":"छह (६)","ref":"six","note":"chah"},
{"target":"सात (७)","ref":"seven","note":"sāt"},
{"target":"आठ (८)","ref":"eight","note":"āṭh"},
{"target":"नौ (९)","ref":"nine","note":"nau"},
{"target":"दस (१०)","ref":"ten","note":"das"},
{"target":"बीस (२०)","ref":"twenty","note":"bīs"},
{"target":"पचास / सौ / हज़ार","ref":"fifty / hundred / thousand","note":"pacās / sau / hazār"}
]},
{"name":"Days, Months & Time (दिन, महीने और समय)","items":[
{"target":"सोमवार","ref":"Monday","note":"somvār — 'vār' means day"},
{"target":"मंगलवार","ref":"Tuesday","note":"mangalvār"},
{"target":"बुधवार","ref":"Wednesday","note":"budhvār"},
{"target":"गुरुवार","ref":"Thursday","note":"guruvār"},
{"target":"शुक्रवार","ref":"Friday","note":"śukravār"},
{"target":"शनिवार","ref":"Saturday","note":"śanivār"},
{"target":"रविवार","ref":"Sunday","note":"ravivār"},
{"target":"आज","ref":"today","note":"āj"},
{"target":"कल","ref":"yesterday / tomorrow","note":"kal — context tells which"},
{"target":"परसों","ref":"day before / after tomorrow","note":"parson"},
{"target":"जनवरी / फरवरी","ref":"January / February","note":"janvarī / farvarī — months use English-derived names"},
{"target":"सुबह / शाम","ref":"morning / evening","note":"subah / śām; रात = night (rāt)"}
]},
{"name":"Essential Verbs (ज़रूरी क्रियाएँ)","items":[
{"target":"होना — मैं हूँ","ref":"to be — I am","note":"honā; वह है (vah hai), वे हैं (ve hain)"},
{"target":"करना — मैं करता हूँ","ref":"to do — I do","note":"karnā; तुम करते हो, वह करता है"},
{"target":"जाना — मैं जाता हूँ","ref":"to go — I go","note":"jānā; वह जाती है (she goes)"},
{"target":"आना — मैं आता हूँ","ref":"to come — I come","note":"ānā"},
{"target":"खाना — मैं खाता हूँ","ref":"to eat — I eat","note":"khānā; also means 'food'"},
{"target":"पीना — मैं पीता हूँ","ref":"to drink — I drink","note":"pīnā"},
{"target":"देखना — मैं देखता हूँ","ref":"to see — I see","note":"dekhnā"},
{"target":"बोलना — मैं बोलता हूँ","ref":"to speak — I speak","note":"bolnā"},
{"target":"समझना — मैं समझता हूँ","ref":"to understand — I understand","note":"samajhnā"},
{"target":"चाहना — मैं चाहता हूँ","ref":"to want — I want","note":"cāhnā"}
]},
{"name":"Question Words & Connectors (प्रश्नवाचक शब्द)","items":[
{"target":"क्या","ref":"what / (yes-no marker)","note":"kyā"},
{"target":"कौन","ref":"who","note":"kaun"},
{"target":"कहाँ","ref":"where","note":"kahān"},
{"target":"कब","ref":"when","note":"kab"},
{"target":"क्यों","ref":"why","note":"kyon"},
{"target":"कैसे","ref":"how","note":"kaise"},
{"target":"कितना","ref":"how much / how many","note":"kitnā — कितनी (f.)"},
{"target":"कौन-सा","ref":"which one","note":"kaun-sā"},
{"target":"और","ref":"and","note":"aur"},
{"target":"लेकिन","ref":"but","note":"lekin"},
{"target":"क्योंकि","ref":"because","note":"kyonki"},
{"target":"इसलिए","ref":"therefore / so","note":"islie"}
]},
{"name":"Survival Phrases (उत्तरजीविता वाक्यांश)","items":[
{"target":"मुझे मदद चाहिए","ref":"I need help","note":"mujhe madad cāhie"},
{"target":"माफ़ कीजिए","ref":"Excuse me / Sorry","note":"māf kījie"},
{"target":"मुझे नहीं पता","ref":"I don't know","note":"mujhe nahīn patā"},
{"target":"मुझे समझ नहीं आया","ref":"I didn't understand","note":"mujhe samajh nahīn āyā"},
{"target":"धीरे बोलिए","ref":"Please speak slowly","note":"dhīre bolie"},
{"target":"शौचालय कहाँ है?","ref":"Where is the toilet?","note":"śaucālay kahān hai?"},
{"target":"यह कितने का है?","ref":"How much is this?","note":"yah kitne kā hai?"},
{"target":"मुझे पानी चाहिए","ref":"I need water","note":"mujhe pānī cāhie"},
{"target":"रुकिए!","ref":"Stop! / Wait!","note":"rukie!"},
{"target":"क्या आप अंग्रेज़ी बोलते हैं?","ref":"Do you speak English?","note":"kyā āp angrezī bolte hain?"},
{"target":"मैं रास्ता भूल गया","ref":"I am lost","note":"main rāstā bhūl gayā — भूल गई (f.)"},
{"target":"डॉक्टर को बुलाओ","ref":"Call a doctor","note":"ḍākṭar ko bulāo"},
{"target":"जल्दी करो","ref":"Hurry up","note":"jaldī karo"},
{"target":"कोई बात नहीं","ref":"It's okay / No worries","note":"koī bāt nahīn"},
{"target":"बहुत अच्छा","ref":"Very good","note":"bahut acchā"}
]},
{"name":"Time & Telling the Clock (समय बताना)","items":[
{"target":"अभी","ref":"now","note":"abhī"},
{"target":"अभी क्या समय है?","ref":"What time is it now?","note":"abhī kyā samay hai?"},
{"target":"एक बजा है","ref":"It is one o'clock","note":"ek bajā hai"},
{"target":"दो बजे हैं","ref":"It is two o'clock","note":"do baje hain — plural from 2 on"},
{"target":"साढ़े तीन","ref":"half past three","note":"sāṛhe tīn — 'sāṛhe' = and a half"},
{"target":"सवा चार","ref":"quarter past four","note":"savā cār — 'savā' = and a quarter"},
{"target":"पौने पाँच","ref":"quarter to five","note":"paune pānc"},
{"target":"डेढ़","ref":"one and a half","note":"ḍeṛh — special word for 1½"},
{"target":"ढाई","ref":"two and a half","note":"ḍhāī — special word for 2½"},
{"target":"मिनट","ref":"minute","note":"minaṭ"},
{"target":"घंटा","ref":"hour","note":"ghanṭā"},
{"target":"आधा घंटा","ref":"half an hour","note":"ādhā ghanṭā"}
]},
{"name":"Common Adjectives & Opposites (विशेषण और विलोम)","items":[
{"target":"बड़ा ↔ छोटा","ref":"big ↔ small","note":"baṛā ↔ choṭā; -ी for feminine"},
{"target":"अच्छा ↔ बुरा","ref":"good ↔ bad","note":"acchā ↔ burā"},
{"target":"नया ↔ पुराना","ref":"new ↔ old","note":"nayā ↔ purānā"},
{"target":"लंबा ↔ छोटा","ref":"tall/long ↔ short","note":"lambā ↔ choṭā"},
{"target":"गरम ↔ ठंडा","ref":"hot ↔ cold","note":"garam ↔ ṭhanḍā"},
{"target":"साफ़ ↔ गंदा","ref":"clean ↔ dirty","note":"sāf ↔ gandā"},
{"target":"आसान ↔ मुश्किल","ref":"easy ↔ difficult","note":"āsān ↔ muśkil"},
{"target":"सस्ता ↔ महँगा","ref":"cheap ↔ expensive","note":"sastā ↔ mahngā"},
{"target":"तेज़ ↔ धीमा","ref":"fast ↔ slow","note":"tez ↔ dhīmā"},
{"target":"खुश ↔ दुखी","ref":"happy ↔ sad","note":"khuś ↔ dukhī"},
{"target":"पास ↔ दूर","ref":"near ↔ far","note":"pās ↔ dūr"},
{"target":"भारी ↔ हल्का","ref":"heavy ↔ light","note":"bhārī ↔ halkā"},
{"target":"सही ↔ ग़लत","ref":"right ↔ wrong","note":"sahī ↔ galat"},
{"target":"पूरा ↔ आधा","ref":"full/whole ↔ half","note":"pūrā ↔ ādhā"},
{"target":"ऊँचा ↔ नीचा","ref":"high ↔ low","note":"ūncā ↔ nīcā"},
{"target":"मीठा ↔ कड़वा","ref":"sweet ↔ bitter","note":"mīṭhā ↔ kaṛvā"}
]},
{"name":"Food & Restaurant Phrases (खाना और रेस्तरां)","items":[
{"target":"मुझे भूख लगी है","ref":"I am hungry","note":"mujhe bhūkh lagī hai"},
{"target":"मुझे प्यास लगी है","ref":"I am thirsty","note":"mujhe pyās lagī hai"},
{"target":"मेन्यू दिखाइए","ref":"Please show the menu","note":"menyū dikhāie"},
{"target":"एक चाय दीजिए","ref":"Please give one tea","note":"ek cāy dījie"},
{"target":"यह शाकाहारी है?","ref":"Is this vegetarian?","note":"yah śākāhārī hai?"},
{"target":"कम तीखा","ref":"less spicy","note":"kam tīkhā"},
{"target":"बहुत स्वादिष्ट है","ref":"It is very delicious","note":"bahut svādiṣṭ hai"},
{"target":"बिल लाइए","ref":"Please bring the bill","note":"bil lāie"},
{"target":"पानी की बोतल","ref":"a bottle of water","note":"pānī kī botal"},
{"target":"मुझे यह पसंद है","ref":"I like this","note":"mujhe yah pasand hai"},
{"target":"थोड़ा और","ref":"a little more","note":"thoṛā aur"},
{"target":"बस, बहुत हुआ","ref":"That's enough","note":"bas, bahut huā"},
{"target":"नमक कम है","ref":"There's too little salt","note":"namak kam hai"},
{"target":"खाना गरम है","ref":"The food is hot","note":"khānā garam hai"},
{"target":"रोटी और दाल","ref":"bread and lentils","note":"roṭī aur dāl"}
]},
{"name":"Shopping & Money (खरीदारी और पैसे)","items":[
{"target":"यह कितने का है?","ref":"How much is this?","note":"yah kitne kā hai?"},
{"target":"बहुत महँगा है","ref":"It's too expensive","note":"bahut mahngā hai"},
{"target":"कुछ कम कीजिए","ref":"Please reduce it a bit","note":"kuch kam kījie — bargaining"},
{"target":"आख़िरी दाम क्या है?","ref":"What's the final price?","note":"ākhirī dām kyā hai?"},
{"target":"मुझे यह चाहिए","ref":"I want this one","note":"mujhe yah cāhie"},
{"target":"दूसरा रंग है?","ref":"Is there another colour?","note":"dūsrā rang hai?"},
{"target":"छूट है?","ref":"Is there a discount?","note":"chūṭ hai?"},
{"target":"नक़द या कार्ड?","ref":"Cash or card?","note":"nakad yā kārḍ?"},
{"target":"रसीद दीजिए","ref":"Please give a receipt","note":"rasīd dījie"},
{"target":"पैसे","ref":"money","note":"paise"},
{"target":"रुपये","ref":"rupees","note":"rupaye"},
{"target":"खुले पैसे","ref":"change (small money)","note":"khule paise"},
{"target":"मैं बस देख रहा हूँ","ref":"I'm just looking","note":"main bas dekh rahā hūn"},
{"target":"ठीक है, ले लूँगा","ref":"Okay, I'll take it","note":"ṭhīk hai, le lūngā"}
]},
{"name":"Weather & Small Talk (मौसम और बातचीत)","items":[
{"target":"आज मौसम कैसा है?","ref":"How's the weather today?","note":"āj mausam kaisā hai?"},
{"target":"आज गरमी है","ref":"It's hot today","note":"āj garmī hai"},
{"target":"आज ठंड है","ref":"It's cold today","note":"āj ṭhanḍ hai"},
{"target":"बारिश हो रही है","ref":"It is raining","note":"bāriś ho rahī hai"},
{"target":"धूप है","ref":"It's sunny","note":"dhūp hai"},
{"target":"आप कहाँ से हैं?","ref":"Where are you from?","note":"āp kahān se hain?"},
{"target":"मैं भारत से हूँ","ref":"I am from India","note":"main bhārat se hūn"},
{"target":"आप क्या करते हैं?","ref":"What do you do (job)?","note":"āp kyā karte hain?"},
{"target":"बहुत दिन हो गए","ref":"It's been a long time","note":"bahut din ho gae"},
{"target":"क्या हाल है?","ref":"What's up? / How's it going?","note":"kyā hāl hai?"},
{"target":"सब ठीक है","ref":"Everything's fine","note":"sab ṭhīk hai"},
{"target":"अच्छा लगा","ref":"That was nice","note":"acchā lagā"},
{"target":"मौसम सुहावना है","ref":"The weather is pleasant","note":"mausam suhāvanā hai"},
{"target":"ख़्याल रखना","ref":"Take care","note":"khyāl rakhnā"}
]},
{"name":"Family Members (परिवार के सदस्य)","items":[
{"target":"माँ / माता","ref":"mother","note":"mān / mātā"},
{"target":"पिता / पापा","ref":"father","note":"pitā / pāpā"},
{"target":"भाई","ref":"brother","note":"bhāī; बड़ा भाई = elder brother"},
{"target":"बहन","ref":"sister","note":"bahan"},
{"target":"बेटा","ref":"son","note":"beṭā"},
{"target":"बेटी","ref":"daughter","note":"beṭī"},
{"target":"दादा / दादी","ref":"paternal grandfather / grandmother","note":"dādā / dādī"},
{"target":"नाना / नानी","ref":"maternal grandfather / grandmother","note":"nānā / nānī"},
{"target":"चाचा","ref":"paternal uncle (father's younger brother)","note":"cācā"},
{"target":"मामा","ref":"maternal uncle (mother's brother)","note":"māmā"},
{"target":"पति / पत्नी","ref":"husband / wife","note":"pati / patnī"},
{"target":"बच्चा / बच्चे","ref":"child / children","note":"baccā / bacce"},
{"target":"रिश्तेदार","ref":"relative","note":"riśtedār"},
{"target":"परिवार","ref":"family","note":"parivār"}
]}
]}
