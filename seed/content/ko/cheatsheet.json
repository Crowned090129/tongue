{"categories":[
{"name":"Greetings & Polite Expressions","items":[
{"target":"안녕하세요","ref":"Hello","note":"annyeonghaseyo — standard polite greeting, any time of day"},
{"target":"안녕히 가세요","ref":"Goodbye (to someone leaving)","note":"annyeonghi gaseyo — literally 'go in peace'"},
{"target":"안녕히 계세요","ref":"Goodbye (said by the one leaving)","note":"annyeonghi gyeseyo — 'stay in peace'"},
{"target":"감사합니다","ref":"Thank you","note":"gamsahamnida — formal; 고마워요 (gomawoyo) is softer"},
{"target":"죄송합니다","ref":"I'm sorry","note":"joesonghamnida — apology; 미안해요 is more casual"},
{"target":"괜찮아요","ref":"It's okay / I'm fine","note":"gwaenchanayo — also 'no thanks' when declining"},
{"target":"실례합니다","ref":"Excuse me","note":"sillyehamnida — to get attention or pass by"},
{"target":"만나서 반갑습니다","ref":"Nice to meet you","note":"mannaseo bangapseumnida"},
{"target":"잘 부탁드립니다","ref":"Please treat me well / I look forward to it","note":"jal butakdeurimnida — said after introductions"},
{"target":"네 / 아니요","ref":"Yes / No","note":"ne / aniyo"},
{"target":"저기요","ref":"Excuse me (calling a server)","note":"jeogiyo — to get staff attention in a shop or restaurant"},
{"target":"수고하셨습니다","ref":"Well done / thanks for your effort","note":"sugohasyeotseumnida — said after work is finished"}
]},
{"name":"Numbers (Native + Sino-Korean)","items":[
{"target":"하나 / 일","ref":"one","note":"hana (native) / il (Sino)"},
{"target":"둘 / 이","ref":"two","note":"dul / i"},
{"target":"셋 / 삼","ref":"three","note":"set / sam"},
{"target":"넷 / 사","ref":"four","note":"net / sa"},
{"target":"다섯 / 오","ref":"five","note":"daseot / o"},
{"target":"여섯 / 육","ref":"six","note":"yeoseot / yuk"},
{"target":"일곱 / 칠","ref":"seven","note":"ilgop / chil"},
{"target":"여덟 / 팔","ref":"eight","note":"yeodeol / pal"},
{"target":"아홉 / 구","ref":"nine","note":"ahop / gu"},
{"target":"열 / 십","ref":"ten","note":"yeol / sip"},
{"target":"스물 / 이십","ref":"twenty","note":"seumul / isip; thirty = 서른 / 삼십"},
{"target":"백 / 천","ref":"hundred / thousand","note":"baek / cheon (both Sino only)"}
]},
{"name":"Days, Months & Time Expressions","items":[
{"target":"월요일","ref":"Monday","note":"woryoil; 화요일 Tue, 수요일 Wed"},
{"target":"목요일","ref":"Thursday","note":"mogyoil; 금요일 Fri, 토요일 Sat, 일요일 Sun"},
{"target":"오늘","ref":"today","note":"oneul"},
{"target":"어제","ref":"yesterday","note":"eoje"},
{"target":"내일","ref":"tomorrow","note":"naeil"},
{"target":"이번 주","ref":"this week","note":"ibeon ju; 다음 주 next week, 지난주 last week"},
{"target":"아침","ref":"morning","note":"achim (also 'breakfast')"},
{"target":"점심","ref":"noon / lunch","note":"jeomsim"},
{"target":"저녁","ref":"evening / dinner","note":"jeonyeok"},
{"target":"밤","ref":"night","note":"bam"},
{"target":"일월 / 이월","ref":"January / February","note":"irwol / iwol — Sino number + 월"},
{"target":"지금","ref":"now","note":"jigeum"}
]},
{"name":"Essential Verbs in 아/어요 Form","items":[
{"target":"있어요","ref":"there is / to have","note":"isseoyo — existence & possession"},
{"target":"없어요","ref":"there isn't / to not have","note":"eopseoyo — opposite of 있어요"},
{"target":"해요","ref":"do","note":"haeyo — from 하다"},
{"target":"가요","ref":"go","note":"gayo — from 가다"},
{"target":"와요","ref":"come","note":"wayo — from 오다"},
{"target":"먹어요","ref":"eat","note":"meogeoyo — from 먹다"},
{"target":"마셔요","ref":"drink","note":"masyeoyo — from 마시다"},
{"target":"봐요","ref":"see / watch","note":"bwayo — from 보다"},
{"target":"들어요","ref":"listen / hear","note":"deureoyo — from 듣다 (ㄷ irregular)"},
{"target":"사요","ref":"buy","note":"sayo — from 사다"}
]},
{"name":"Question Words & Connectors","items":[
{"target":"뭐 / 무엇","ref":"what","note":"mwo (casual) / mueot (formal)"},
{"target":"누구","ref":"who","note":"nugu; subject form 누가 (nuga)"},
{"target":"어디","ref":"where","note":"eodi"},
{"target":"언제","ref":"when","note":"eonje"},
{"target":"왜","ref":"why","note":"wae"},
{"target":"어떻게","ref":"how","note":"eotteoke"},
{"target":"얼마","ref":"how much (price)","note":"eolma"},
{"target":"몇","ref":"how many","note":"myeot — before a counter"},
{"target":"그리고","ref":"and","note":"geurigo — connects sentences"},
{"target":"그런데","ref":"but / by the way","note":"geureonde"},
{"target":"그래서","ref":"so / therefore","note":"geuraeseo"},
{"target":"그러면","ref":"then / in that case","note":"geureomyeon"}
]},
{"name":"Survival Phrases","items":[
{"target":"이거 주세요","ref":"I'll take this one, please","note":"igeo juseyo — pointing at an item"},
{"target":"얼마예요?","ref":"How much is it?","note":"eolmayeyo?"},
{"target":"화장실이 어디예요?","ref":"Where is the bathroom?","note":"hwajangsiri eodiyeyo?"},
{"target":"영어 하세요?","ref":"Do you speak English?","note":"yeongeo haseyo?"},
{"target":"천천히 말씀해 주세요","ref":"Please speak slowly","note":"cheoncheonhi malsseumhae juseyo"},
{"target":"다시 한 번 말해 주세요","ref":"Please say it again","note":"dasi han beon malhae juseyo"},
{"target":"잘 모르겠어요","ref":"I don't understand / I'm not sure","note":"jal moreugesseoyo"},
{"target":"도와주세요","ref":"Please help me","note":"dowajuseyo"},
{"target":"계산해 주세요","ref":"The bill, please","note":"gyesanhae juseyo"},
{"target":"이거 뭐예요?","ref":"What is this?","note":"igeo mwoyeyo?"},
{"target":"괜찮아요, 됐어요","ref":"It's fine, no thanks","note":"gwaenchanayo, dwaesseoyo — politely declining"},
{"target":"여기요!","ref":"Over here! (calling staff)","note":"yeogiyo!"}
]},
{"name":"Telling the Clock","items":[
{"target":"몇 시예요?","ref":"What time is it?","note":"myeot siyeyo?"},
{"target":"한 시","ref":"one o'clock","note":"han si — hours use native numbers"},
{"target":"두 시","ref":"two o'clock","note":"du si"},
{"target":"세 시","ref":"three o'clock","note":"se si"},
{"target":"열두 시","ref":"twelve o'clock","note":"yeoldu si"},
{"target":"삼십 분","ref":"thirty minutes (half past)","note":"samsip bun — minutes use Sino numbers"},
{"target":"오 분","ref":"five minutes","note":"o bun"},
{"target":"반","ref":"half (past)","note":"ban — 두 시 반 = 2:30"},
{"target":"오전","ref":"a.m.","note":"ojeon"},
{"target":"오후","ref":"p.m.","note":"ohu"},
{"target":"정각","ref":"o'clock sharp","note":"jeonggak"},
{"target":"시간","ref":"hour / time (duration)","note":"sigan — 한 시간 = one hour"}
]},
{"name":"Common Adjectives & Opposites","items":[
{"target":"커요 / 작아요","ref":"big / small","note":"keoyo / jagayo"},
{"target":"많아요 / 적어요","ref":"many / few","note":"manayo / jeogeoyo"},
{"target":"좋아요 / 나빠요","ref":"good / bad","note":"joayo / nappayo"},
{"target":"비싸요 / 싸요","ref":"expensive / cheap","note":"bissayo / ssayo"},
{"target":"길어요 / 짧아요","ref":"long / short","note":"gireoyo / jjalbayo"},
{"target":"빨라요 / 느려요","ref":"fast / slow","note":"ppallayo / neuryeoyo"},
{"target":"더워요 / 추워요","ref":"hot / cold (weather)","note":"deowoyo / chuwoyo"},
{"target":"쉬워요 / 어려워요","ref":"easy / difficult","note":"swiwoyo / eoryeowoyo"},
{"target":"새것 / 낡았어요","ref":"new / old (worn)","note":"saegeot / nalgasseoyo"},
{"target":"맛있어요 / 맛없어요","ref":"delicious / tasteless","note":"masisseoyo / madeopseoyo"},
{"target":"가까워요 / 멀어요","ref":"near / far","note":"gakkawoyo / meoreoyo"},
{"target":"예뻐요 / 못생겼어요","ref":"pretty / ugly","note":"yeppeoyo / motsaenggyeosseoyo"}
]},
{"name":"Food & Restaurant Phrases","items":[
{"target":"메뉴 좀 주세요","ref":"Menu, please","note":"menyu jom juseyo"},
{"target":"뭐가 맛있어요?","ref":"What's good here?","note":"mwoga masisseoyo?"},
{"target":"이거 하나 주세요","ref":"One of these, please","note":"igeo hana juseyo"},
{"target":"물 좀 주세요","ref":"Some water, please","note":"mul jom juseyo"},
{"target":"반찬 더 주세요","ref":"More side dishes, please","note":"banchan deo juseyo"},
{"target":"맛있어요","ref":"It's delicious","note":"masisseoyo"},
{"target":"안 매워요?","ref":"Is it not spicy?","note":"an maewoyo?"},
{"target":"매운 거 못 먹어요","ref":"I can't eat spicy food","note":"maeun geo mot meogeoyo"},
{"target":"포장해 주세요","ref":"To go, please","note":"pojanghae juseyo"},
{"target":"잘 먹겠습니다","ref":"I will enjoy this meal (before eating)","note":"jal meokgetseumnida"},
{"target":"잘 먹었습니다","ref":"That was a good meal (after eating)","note":"jal meogeotseumnida"},
{"target":"계산은 어디서 해요?","ref":"Where do I pay?","note":"gyesaneun eodiseo haeyo?"}
]},
{"name":"Shopping & Money","items":[
{"target":"얼마예요?","ref":"How much is it?","note":"eolmayeyo?"},
{"target":"너무 비싸요","ref":"It's too expensive","note":"neomu bissayo"},
{"target":"좀 깎아 주세요","ref":"Please give me a discount","note":"jom kkakka juseyo"},
{"target":"카드 돼요?","ref":"Do you take card?","note":"kadeu dwaeyo?"},
{"target":"현금으로 낼게요","ref":"I'll pay in cash","note":"hyeongeumeuro naelgeyo"},
{"target":"입어 봐도 돼요?","ref":"Can I try it on?","note":"ibeo bwado dwaeyo?"},
{"target":"더 큰 사이즈 있어요?","ref":"Do you have a bigger size?","note":"deo keun saijeu isseoyo?"},
{"target":"다른 색 있어요?","ref":"Is there another color?","note":"dareun saek isseoyo?"},
{"target":"영수증 주세요","ref":"A receipt, please","note":"yeongsujeung juseyo"},
{"target":"환불돼요?","ref":"Can I get a refund?","note":"hwanbuldwaeyo?"},
{"target":"봉투 주세요","ref":"A bag, please","note":"bongtu juseyo"},
{"target":"그냥 구경할게요","ref":"I'm just looking","note":"geunyang gugyeonghalgeyo"}
]},
{"name":"Weather & Small Talk","items":[
{"target":"날씨가 좋아요","ref":"The weather is nice","note":"nalssiga joayo"},
{"target":"오늘 더워요","ref":"It's hot today","note":"oneul deowoyo"},
{"target":"비가 와요","ref":"It's raining","note":"biga wayo"},
{"target":"눈이 와요","ref":"It's snowing","note":"nuni wayo"},
{"target":"바람이 불어요","ref":"It's windy","note":"barami bureoyo"},
{"target":"요즘 어때요?","ref":"How have you been lately?","note":"yojeum eottaeyo?"},
{"target":"잘 지내요","ref":"I'm doing well","note":"jal jinaeyo"},
{"target":"주말에 뭐 해요?","ref":"What are you doing this weekend?","note":"jumare mwo haeyo?"},
{"target":"바빠요","ref":"I'm busy","note":"bappayo"},
{"target":"피곤해요","ref":"I'm tired","note":"pigonhaeyo"},
{"target":"봄 / 여름 / 가을 / 겨울","ref":"spring / summer / fall / winter","note":"bom / yeoreum / gaeul / gyeoul"},
{"target":"미세먼지가 심해요","ref":"The fine dust is bad","note":"misemeonjiga simhaeyo — common Korean topic"}
]},
{"name":"Family Members","items":[
{"target":"아버지 / 아빠","ref":"father / dad","note":"abeoji (formal) / appa (casual)"},
{"target":"어머니 / 엄마","ref":"mother / mom","note":"eomeoni / eomma"},
{"target":"형","ref":"older brother (male's)","note":"hyeong — used by a younger male"},
{"target":"오빠","ref":"older brother (female's)","note":"oppa — used by a younger female"},
{"target":"누나","ref":"older sister (male's)","note":"nuna — used by a younger male"},
{"target":"언니","ref":"older sister (female's)","note":"eonni — used by a younger female"},
{"target":"동생","ref":"younger sibling","note":"dongsaeng; 남동생 brother, 여동생 sister"},
{"target":"할아버지","ref":"grandfather","note":"harabeoji"},
{"target":"할머니","ref":"grandmother","note":"halmeoni"},
{"target":"부모님","ref":"parents","note":"bumonim — honorific"},
{"target":"아들 / 딸","ref":"son / daughter","note":"adeul / ttal"},
{"target":"가족","ref":"family","note":"gajok"}
]}
]}
